---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { getSiteUrl, getCanonicalUrl, isPreviewEnvironment } from '../utils/seo';
import { SITE_IMAGES } from '../data/siteConfig';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: (Record<string, any> | null | undefined)[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title = '서울 탄성코트 시공 안내 | 올케어탄성',
  description = '서울권 베란다와 세탁실의 탄성코트 시공을 안내합니다. 기존 도막, 균열, 습기 흔적 등 벽면 상태와 필요한 작업 범위를 확인하고 상담받을 수 있습니다.',
  path = '',
  jsonLd = [],
  image = SITE_IMAGES.ogMainThumb,
  imageAlt = SITE_IMAGES.ogMainThumbAlt,
  imageWidth = SITE_IMAGES.ogWidth,
  imageHeight = SITE_IMAGES.ogHeight,
} = Astro.props;

const isPreview = isPreviewEnvironment();

// 운영 도메인은 신규 독립 도메인 환경변수(SITE_URL) 또는 Astro.site에서만 가져옵니다.
// Preview 환경에서는 운영 Canonical 및 색인 신호 유출을 원천 차단합니다.
const siteUrl = isPreview ? '' : getSiteUrl(Astro.site);
const canonicalUrl = isPreview ? null : getCanonicalUrl(path, siteUrl);
const validJsonLd = isPreview ? [] : jsonLd.filter((item): item is Record<string, any> => !!item);
const ogImageUrl = siteUrl ? `${siteUrl}${image}` : '';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 미리보기(Preview) 환경 검색엔진 색인 방지 -->
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL (도메인 설정 및 정식 배포 시에만 유효 출력) -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph 메타데이터 -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="올케어탄성" />
    <meta property="og:locale" content="ko_KR" />
    {siteUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}

    <!-- Twitter Card 메타데이터 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {siteUrl && (
      <>
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}

    <!-- JSON-LD 구조화 데이터 -->
    {validJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- 파비콘 및 모바일 앱 아이콘 -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- S-Core Dream 웹폰트 프리로드 (본문 400 & 메인 헤딩 700) -->
    <link rel="preload" href="/fonts/score-dream/SCDream4.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/score-dream/SCDream7.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F5F3EE] text-[#3E443B] antialiased">
    <Header />
    <main class="flex-1 pb-16 sm:pb-0">
      <slot />
    </main>
    <Footer />

    <!-- 모바일 전용 상담 플로팅 CTA (하단 고정) -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 p-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] bg-[#FAF8F5]/95 backdrop-blur-md border-t border-[#E7D9C1] shadow-lg">
      <div class="max-w-md mx-auto flex items-center justify-between gap-3 px-2">
        <div class="text-left leading-tight">
          <span class="text-[10px] text-[#5C5549] block">올케어탄성 서울권 상담</span>
          <span class="text-xs font-bold text-[#3E443B]">010-8492-6900</span>
        </div>
        <a
          href="tel:01084926900"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#4F5844] text-[#F5F3EE] text-xs font-semibold shadow-sm hover:bg-[#3E443B] transition-colors active:scale-95"
          aria-label="대표 전화 상담 바로 연결"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>전화 상담하기</span>
        </a>
      </div>
    </div>
  </body>
</html>
