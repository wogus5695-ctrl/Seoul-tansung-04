---
interface TimelineStep {
  step: string;
  title: string;
}

interface Props {
  keyword?: string;
  class?: string;
}

const {
  keyword = '탄성코트',
  class: className = '',
} = Astro.props;

const STEPS: TimelineStep[] = [
  { step: '01', title: '상담 접수' },
  { step: '02', title: '현장 상태 확인' },
  { step: '03', title: '작업 범위 안내' },
  { step: '04', title: '보양 및 시공' },
  { step: '05', title: '마감 확인 및 안내' },
];
---

<section
  id="process"
  class:list={['w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]', className]}
>
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
    
    {/* 헤더: 영문 라벨 제거, 신규 제목 및 동적키워드 1회 반영 설명문 */}
    <div class="space-y-2 sm:space-y-2.5 text-left max-w-2xl">
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#3E443B]">
        상담부터 작업까지
      </h2>
      <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
        현장 상태와 위치를 공유해주시면 <strong class="font-semibold text-[#2D322A]">{keyword}</strong> 상담부터 견적, 작업 일정 안내까지 보다 빠르게 도와드릴 수 있습니다.
      </p>
    </div>

    {/* 타임라인 컨테이너 */}
    <div class="w-full">
      
      {/* 1. PC 가로형 타임라인 (sm 이상) */}
      <div class="hidden sm:block relative pt-2 pb-4">
        {/* 가로 연결선 (첫 번째 원형 중심 10% ~ 마지막 원형 중심 90%) */}
        <div
          class="absolute top-7 left-[10%] right-[10%] h-[2px] bg-[#E7D9C1]"
          aria-hidden="true"
        />

        <div class="grid grid-cols-5 gap-3 lg:gap-4 relative z-10">
          {STEPS.map((item) => (
            <div class="flex flex-col items-center text-center group">
              {/* 원형 숫자 뱃지 */}
              <div class="w-10 h-10 lg:w-11 lg:h-11 rounded-full bg-[#FAF8F5] border-2 border-[#4F5844] text-[#4F5844] font-mono font-bold text-xs lg:text-sm flex items-center justify-center shadow-xs transition-transform group-hover:scale-105 group-hover:border-[#2D322A] group-hover:text-[#2D322A] select-none">
                {item.step}
              </div>

              {/* 단계 제목 */}
              <span class="mt-3 text-xs sm:text-sm lg:text-[15px] font-bold text-[#3E443B] tracking-tight leading-snug">
                {item.title}
              </span>
            </div>
          ))}
        </div>
      </div>

      {/* 2. MO 세로형 타임라인 (sm 미만) */}
      <div class="block sm:hidden relative pl-12 py-1 space-y-4">
        {/* 세로 연결선 (원형 뱃지 중심축인 x=18px 통과) */}
        <div
          class="absolute left-[17px] top-4 bottom-4 w-[2px] bg-[#E7D9C1]"
          aria-hidden="true"
        />

        {STEPS.map((item) => (
          <div class="relative flex items-center min-h-[38px] group">
            {/* 세로선 상에 정렬된 원형 숫자 뱃지 */}
            <div class="absolute -left-12 w-9 h-9 rounded-full bg-[#FAF8F5] border-2 border-[#4F5844] text-[#4F5844] font-mono font-bold text-xs flex items-center justify-center shadow-2xs select-none">
              {item.step}
            </div>

            {/* 단계 제목 */}
            <span class="text-sm font-bold text-[#3E443B] tracking-tight pl-1">
              {item.title}
            </span>
          </div>
        ))}
      </div>

    </div>

    {/* 하단 안내문 (보조 스타일) */}
    <p class="text-[11px] sm:text-xs text-[#5C5549]/75 text-left border-t border-[#E7D9C1]/50 pt-3 sm:pt-4">
      ※ 실작업 순서와 범위는 현장 상태, 공간 구조, 기존 벽면 상태에 따라 달라질 수 있습니다.
    </p>

  </div>
</section>
