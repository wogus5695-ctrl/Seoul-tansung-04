---
interface Props {
  label?: string;
  subLabel?: string;
  tag?: string;
  tagVariant?: 'before' | 'after' | 'neutral';
  aspectRatio?: string;
  class?: string;
}

const {
  label = '현장사진 등록 예정',
  subLabel = '시공 완료 후 실제 현장 사진이 등록될 예정입니다.',
  tag,
  tagVariant = 'neutral',
  aspectRatio = 'aspect-[4/3]',
  class: className = '',
} = Astro.props;

const tagClasses = {
  before: 'bg-[#E7D9C1]/60 text-[#5C5549] border-[#E7D9C1]',
  after: 'bg-[#4F5844] text-[#F5F3EE] border-[#4F5844]',
  neutral: 'bg-[#FAF8F5] text-[#5C5549] border-[#E7D9C1]',
}[tagVariant];
---

<div
  class:list={[
    'relative w-full rounded-xl border border-dashed border-[#E7D9C1] bg-[#FAF8F5] p-5 sm:p-6 flex flex-col items-center justify-center text-center transition-colors select-none',
    aspectRatio,
    className,
  ]}
  role="img"
  aria-label={label}
>
  {tag && (
    <div class="absolute top-3 left-3 sm:top-4 sm:left-4">
      <span class:list={['inline-block text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded border', tagClasses]}>
        {tag}
      </span>
    </div>
  )}

  <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#F5F3EE] border border-[#E7D9C1] flex items-center justify-center text-[#5C5549] mb-2.5 sm:mb-3 shrink-0">
    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
    </svg>
  </div>
  <p class="text-xs sm:text-sm font-semibold text-[#3E443B]">{label}</p>
  {subLabel && <p class="text-[11px] sm:text-xs text-[#5C5549] mt-1 max-w-[240px] leading-relaxed">{subLabel}</p>}
</div>
