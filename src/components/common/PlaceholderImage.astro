---
interface Props {
  label?: string;
  subLabel?: string;
  aspectRatio?: string;
  class?: string;
}

const {
  label = '현장사진 등록 예정',
  subLabel = '시공 완료 후 실제 현장 사진이 등록될 예정입니다.',
  aspectRatio = 'aspect-[4/3]',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'relative w-full rounded-xl border border-dashed border-[#E7D9C1] bg-[#FAF8F5] p-6 flex flex-col items-center justify-center text-center transition-colors',
    aspectRatio,
    className,
  ]}
  role="img"
  aria-label={label}
>
  <div class="w-12 h-12 rounded-full bg-[#F5F3EE] border border-[#E7D9C1] flex items-center justify-center text-[#5C5549] mb-3">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
    </svg>
  </div>
  <p class="text-sm font-semibold text-[#3E443B]">{label}</p>
  {subLabel && <p class="text-xs text-[#5C5549] mt-1 max-w-xs">{subLabel}</p>}
</div>
