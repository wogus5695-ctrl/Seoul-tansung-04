---
// Header.astro - 올케어탄성 공통 헤더
---

<header class="w-full bg-[#FAF8F5]/95 backdrop-blur-sm border-b border-[#E7D9C1] sticky top-0 z-40">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- 브랜드 로고 -->
    <a href="/" class="flex items-center group py-1" aria-label="올케어탄성 홈">
      <img
        src="/images/allcare/allcare-signature.png"
        alt="올케어탄성 로고"
        width="170"
        height="63"
        class="w-[130px] sm:w-[155px] lg:w-[170px] h-auto object-contain"
      />
    </a>

    <!-- 내비게이션 (확장 가능 구조) -->
    <nav aria-label="메인 내비게이션" class="hidden md:flex items-center gap-6">
      <a href="/" class="text-sm font-medium text-[#3E443B] hover:text-[#4F5844] transition-colors">
        홈
      </a>
      <span class="text-xs text-[#5C5549] bg-[#E7D9C1]/40 px-2.5 py-1 rounded-full">
        서울권 전역 시공 안내
      </span>
    </nav>

    <!-- 대표 상담 전화 링크 -->
    <div class="flex items-center gap-2">
      <a
        href="tel:01084926900"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#F5F3EE] px-4 py-2 rounded-full bg-[#4F5844] hover:bg-[#3E443B] transition-colors shadow-sm"
        aria-label="대표 상담 전화 연결 010-8492-6900"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span>010-8492-6900</span>
      </a>
    </div>
  </div>
</header>
