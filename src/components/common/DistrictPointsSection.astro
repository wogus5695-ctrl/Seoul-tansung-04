---
import type { TargetSpaceItem, ScopeFactorItem } from '../../data/pages';

export interface Props {
  keyword: string;
  regionName?: string;
  title?: string;
  description?: string;
  targetSpaces?: TargetSpaceItem[];
  scopeFactors?: ScopeFactorItem[];
  class?: string;
}

const {
  keyword,
  regionName = '',
  title,
  description,
  targetSpaces = [],
  scopeFactors = [],
  class: className = '',
} = Astro.props;

const hasSpaces = Boolean(targetSpaces && targetSpaces.length > 0);
const hasScope = Boolean(scopeFactors && scopeFactors.length > 0);
---

{ (hasSpaces || hasScope) && (
  <section
    id="district-points"
    class:list={['w-full py-12 sm:py-16 bg-[#F5F3EE] border-b border-[#E7D9C1]', className]}
  >
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      {/* 0. 섹션 통합 대제목 (title 전달 시) */}
      {title && (
        <div class="space-y-2 sm:space-y-2.5 text-left max-w-2xl">
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#3E443B]">
            {title}
          </h2>
          {description && (
            <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
              {description}
            </p>
          )}
        </div>
      )}

      {/* 1. 시공 대상 공간 안내 (Target Spaces) */}
      {hasSpaces && (
        <div class="space-y-6">
          <div class="space-y-2 sm:space-y-2.5 text-left max-w-2xl">
            {title ? (
              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold tracking-tight text-[#3E443B]">
                {regionName ? `${regionName} 시공 대상 공간 안내` : `${keyword} 시공 대상 공간 안내`}
              </h3>
            ) : (
              <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#3E443B]">
                {regionName ? `${regionName} 시공 대상 공간 안내` : `${keyword} 시공 대상 공간 안내`}
              </h2>
            )}
            <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
              공간별 습기 유입 경로와 환경에 따라 중점적으로 확인해야 할 사항입니다.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
            {targetSpaces.map((item, idx) => (
              <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5 shadow-2xs text-left">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/70 text-[#3E443B] font-mono font-bold text-xs flex items-center justify-center shrink-0">
                    {idx + 1}
                  </span>
                  {title ? (
                    <h4 class="text-base font-bold text-[#3E443B]">{item.title}</h4>
                  ) : (
                    <h3 class="text-base font-bold text-[#3E443B]">{item.title}</h3>
                  )}
                </div>
                <p class="text-xs font-semibold text-[#4F5844]">{item.subtitle}</p>
                <p class="text-xs text-[#5C5549] leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* 공간 안내와 작업 조건이 모두 존재할 경우 구분선 */}
      {hasSpaces && hasScope && (
        <div class="border-t border-[#E7D9C1]/70" aria-hidden="true" />
      )}

      {/* 2. 작업 범위와 견적 영향 조건 (Scope Factors) */}
      {hasScope && (
        <div class="space-y-6">
          <div class="space-y-2 sm:space-y-2.5 text-left max-w-2xl">
            {title ? (
              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold tracking-tight text-[#3E443B]">
                작업 범위와 견적에 영향을 주는 실제 조건
              </h3>
            ) : (
              <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#3E443B]">
                작업 범위와 견적에 영향을 주는 실제 조건
              </h2>
            )}
            <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
              공간 면적뿐만 아니라 현장의 벽체 바탕면 상태와 작업 환경에 따라 준비 범위가 달라집니다.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
            {scopeFactors.map((item) => (
              <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5 shadow-2xs text-left">
                {title ? (
                  <h4 class="text-sm sm:text-base font-bold text-[#3E443B]">{item.title}</h4>
                ) : (
                  <h3 class="text-sm sm:text-base font-bold text-[#3E443B]">{item.title}</h3>
                )}
                <div class="space-y-1.5 text-xs">
                  <div>
                    <span class="font-semibold text-[#4F5844] block mb-0.5">현장 조건:</span>
                    <p class="text-[#5C5549] leading-relaxed">{item.condition}</p>
                  </div>
                  <div class="pt-1.5 border-t border-[#E7D9C1]/50">
                    <span class="font-semibold text-[#4F5844] block mb-0.5">시공 영향:</span>
                    <p class="text-[#5C5549] leading-relaxed">{item.impact}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>
)}
