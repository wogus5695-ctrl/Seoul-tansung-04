---
import { SITE_CONTACT, SITE_IMAGES } from '../../data/siteConfig';

export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface HeroCta {
  text: string;
  href: string;
  ariaLabel?: string;
}

interface Props {
  bgImage?: string;
  bgAlt?: string;
  badge: string;
  h1: string;
  description: string;
  subDescription?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  note?: string;
  breadcrumbs?: BreadcrumbItem[];
  class?: string;
}

const {
  bgImage = SITE_IMAGES.defaultHeroBg,
  bgAlt = SITE_IMAGES.defaultHeroAlt,
  badge,
  h1,
  description,
  subDescription,
  primaryCta = {
    text: `전화 상담하기 (${SITE_CONTACT.phone})`,
    href: SITE_CONTACT.telHref,
    ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
  },
  secondaryCta,
  note,
  breadcrumbs,
  class: className = '',
} = Astro.props;
---

<section
  class:list={[
    'relative w-full border-b border-[#E7D9C1]/70 bg-[#FAF8F5] overflow-hidden',
    className,
  ]}
>
  {/* ============================================================== */}
  {/* [1] 모바일 전용 HERO (< lg) : 배경 이미지 + 상단 소프트 오버레이 */}
  {/* ============================================================== */}
  <div class="block lg:hidden relative w-full min-h-[600px] sm:min-h-[640px] flex flex-col justify-between overflow-hidden">
    <!-- 배경 이미지: 실제 현장사진의 창호/벽면이 하단에 선명하게 드러나도록 배치 -->
    <div class="absolute inset-0 z-0 select-none pointer-events-none">
      <img
        src={bgImage}
        alt={bgAlt}
        class="w-full h-full object-cover object-[center_35%] scale-100"
        loading="eager"
        fetchpriority="high"
      />
      <!-- 상단 텍스트 영역에만 가독성 확보 그라데이션 적용 (하단 40%는 원본 사진 그대로 선명하게 노출) -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/95 via-[#FAF8F5]/85 via-50% to-[#FAF8F5]/10 pointer-events-none"
        aria-hidden="true"
      ></div>
    </div>

    <!-- 상단 텍스트 콘텐츠 -->
    <div class="relative z-10 w-full px-5 pt-8 sm:pt-10 pb-4 space-y-3.5 text-left">
      <!-- Breadcrumb (상세페이지) -->
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav aria-label="breadcrumb" class="mb-2 text-xs text-[#5C5549] flex items-center flex-wrap gap-1.5">
          {breadcrumbs.map((item, idx) => (
            <>
              {idx > 0 && <span class="text-[#5C5549]/50">/</span>}
              {item.url ? (
                <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                  {item.name}
                </a>
              ) : (
                <span class="font-semibold text-[#3E443B]">{item.name}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <!-- 배지 -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E7D9C1]/80 text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
        <span>{badge}</span>
      </div>

      <!-- 단일 H1 -->
      <h1 class="text-2xl sm:text-3xl font-bold text-[#3E443B] tracking-tight leading-snug">
        {h1}
      </h1>

      <!-- 메인 설명문 -->
      <p class="text-sm sm:text-base text-[#3E443B] font-medium leading-relaxed">
        {description}
      </p>

      <!-- 보조 설명문 (선택) -->
      {subDescription && (
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          {subDescription}
        </p>
      )}

      <!-- 모바일 CTA: 전화 상담 버튼은 헤더/하단플로팅과 중복되므로 제거. 보조 CTA만 콤팩트하게 제공 -->
      {secondaryCta && (
        <div class="pt-1">
          <a
            href={secondaryCta.href}
            class="inline-flex items-center px-4 py-2 rounded-md text-xs font-semibold text-[#3E443B] bg-[#FAF8F5]/90 hover:bg-[#FAF8F5] transition-colors border border-[#E7D9C1] shadow-xs"
            aria-label={secondaryCta.ariaLabel || secondaryCta.text}
          >
            <span>{secondaryCta.text}</span>
            <svg class="w-3.5 h-3.5 ml-1 text-[#5C5549]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
        </div>
      )}

      {note && (
        <p class="text-[11px] text-[#5C5549]/90 pt-0.5">
          {note}
        </p>
      )}
    </div>

    <!-- 하단 공간 여백: 실제 사진의 창호와 탄성 벽면이 가려지지 않고 선명하게 노출되도록 확보 -->
    <div class="relative z-10 h-44 sm:h-52 pointer-events-none" aria-hidden="true"></div>
  </div>

  {/* ============================================================== */}
  {/* [2] PC 전용 HERO (>= lg) : 2열 구조 (좌측 45% 텍스트 / 우측 55% 대형 실사) */}
  {/* ============================================================== */}
  <div class="hidden lg:block relative w-full max-w-7xl mx-auto px-8 lg:px-12 py-12 lg:py-16">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center min-h-[540px] xl:min-h-[580px]">
      <!-- 좌측 텍스트 컬럼 (약 45% : 12컬럼 중 5컬럼) -->
      <div class="col-span-5 space-y-5 text-left">
        <!-- Breadcrumb (상세페이지) -->
        {breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="breadcrumb" class="text-xs text-[#5C5549] flex items-center flex-wrap gap-2">
            {breadcrumbs.map((item, idx) => (
              <>
                {idx > 0 && <span class="text-[#5C5549]/60">/</span>}
                {item.url ? (
                  <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                    {item.name}
                  </a>
                ) : (
                  <span class="font-semibold text-[#3E443B]">{item.name}</span>
                )}
              </>
            ))}
          </nav>
        )}

        <!-- 브랜드 상단 배지 -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#E7D9C1]/70 text-xs font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
          <span>{badge}</span>
        </div>

        <!-- 단일 H1 메인 타이틀 -->
        <h1 class="text-3xl xl:text-4xl font-bold text-[#3E443B] tracking-tight leading-[1.25]">
          {h1}
        </h1>

        <!-- 메인 핵심 설명문 -->
        <p class="text-base xl:text-lg text-[#3E443B] font-medium leading-relaxed">
          {description}
        </p>

        <!-- 보조 설명문 (선택) -->
        {subDescription && (
          <p class="text-sm text-[#5C5549] leading-relaxed">
            {subDescription}
          </p>
        )}

        <!-- PC CTA 버튼 영역 (전화 상담 + 시공 전후 안내) -->
        <div class="pt-2 flex flex-wrap gap-3 xl:gap-4 items-center">
          <a
            href={primaryCta.href}
            class="px-6 py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-sm hover:bg-[#3E443B] transition-colors shadow-sm inline-flex items-center justify-center gap-2 active:scale-95"
            aria-label={primaryCta.ariaLabel || primaryCta.text}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{primaryCta.text}</span>
          </a>

          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="px-5 py-3.5 rounded-md text-[#5C5549] hover:text-[#3E443B] hover:bg-[#FAF8F5] transition-colors text-sm text-center border border-[#E7D9C1] bg-[#FAF8F5]/80 font-medium"
              aria-label={secondaryCta.ariaLabel || secondaryCta.text}
            >
              {secondaryCta.text}
            </a>
          )}
        </div>

        {note && (
          <p class="text-xs text-[#5C5549]/80 pt-1">
            {note}
          </p>
        )}
      </div>

      <!-- 우측 대형 실사 이미지 영역 (약 55% : 12컬럼 중 7컬럼) -->
      <!-- 불필요한 테두리/오버레이 제거, 원본 색감과 공간감(창호, 벽면, 천장) 100% 보존 -->
      <div class="col-span-7 h-[500px] xl:h-[560px] w-full rounded-2xl overflow-hidden shadow-xs relative select-none">
        <img
          src={bgImage}
          alt={bgAlt}
          class="w-full h-full object-cover object-[center_35%] transition-transform duration-700"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
