---
import { SITE_CONTACT, SITE_IMAGES } from '../../data/siteConfig';

export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface HeroCta {
  text: string;
  href: string;
  ariaLabel?: string;
}

export interface AnchorLink {
  text: string;
  href: string;
  ariaLabel?: string;
}

interface Props {
  bgImage?: string;
  bgAlt?: string;
  badge: string;
  h1: string;
  description: string;
  subDescription?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  mobileAnchorCta?: AnchorLink;
  note?: string;
  breadcrumbs?: BreadcrumbItem[];
  class?: string;
}

const {
  bgImage = SITE_IMAGES.defaultHeroBg,
  bgAlt = SITE_IMAGES.defaultHeroAlt,
  badge,
  h1,
  description,
  subDescription,
  primaryCta = {
    text: `전화 상담하기 (${SITE_CONTACT.phone})`,
    href: SITE_CONTACT.telHref,
    ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
  },
  secondaryCta,
  mobileAnchorCta = {
    text: '벽면 상태 확인 ↓',
    href: '#wall-check',
    ariaLabel: '벽면 상태 확인 섹션으로 이동',
  },
  note,
  breadcrumbs,
  class: className = '',
} = Astro.props;
---

<section
  class:list={[
    'relative w-full border-b border-[#E7D9C1]/70 bg-[#FAF8F5] overflow-hidden',
    className,
  ]}
>
  <!-- [모바일 전용 배경 레이어 (< lg)] : 풀블리드 현장사진 + 가독성 보정 그라데이션 오버레이 -->
  <div class="block lg:hidden absolute inset-0 z-0 select-none pointer-events-none" aria-hidden="true">
    <img
      src={bgImage}
      alt={bgAlt}
      class="w-full h-full object-cover object-[center_30%] scale-100"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/40 via-[#FAF8F5]/88 via-48% to-transparent pointer-events-none"
    ></div>
  </div>

  <!-- [통합 반응형 HERO 컨테이너] : 모바일 세로 중앙 정렬 & 데스크톱 12컬럼 사이드-바이-사이드 그리드 -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 xl:px-12 py-12 sm:py-16 min-h-[640px] sm:min-h-[680px] lg:min-h-0 flex flex-col justify-center lg:block">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-14 items-center min-h-0 lg:min-h-[520px] xl:min-h-[560px]">
      <!-- 좌측 텍스트 컬럼 (DOM 상 단일 H1 선언) -->
      <div class="w-full max-w-lg lg:max-w-none lg:col-span-6 xl:col-span-5 space-y-3.5 sm:space-y-4 lg:space-y-4 xl:space-y-5 text-left flex flex-col justify-center">
        <!-- Breadcrumb (상세페이지 전용) -->
        {breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="breadcrumb" class="mb-1 lg:mb-0 text-xs text-[#5C5549] flex items-center flex-wrap gap-1.5 lg:gap-2">
            {breadcrumbs.map((item, idx) => (
              <>
                {idx > 0 && <span class="text-[#5C5549]/50 lg:text-[#5C5549]/60">/</span>}
                {item.url ? (
                  <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                    {item.name}
                  </a>
                ) : (
                  <span class="font-semibold text-[#3E443B]">{item.name}</span>
                )}
              </>
            ))}
          </nav>
        )}

        <!-- 1. 영문 Badge -->
        <div>
          <span class="inline-flex items-center gap-1.5 lg:gap-2 px-3 lg:px-3.5 py-1 rounded-full bg-[#E7D9C1]/80 lg:bg-[#E7D9C1]/70 text-[11px] lg:text-xs font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
            {badge}
          </span>
        </div>

        <!-- 2. 단일 H1 메인 타이틀 (의미상/DOM상 정확히 1개 존재) -->
        <h1 class="text-2xl sm:text-3xl lg:text-3xl xl:text-4xl font-bold text-[#3E443B] tracking-tight leading-snug lg:leading-[1.25]">
          {h1}
        </h1>

        <!-- 3. 주요 설명 -->
        <p class="text-sm sm:text-base lg:text-base xl:text-lg text-[#3E443B] font-normal leading-relaxed">
          {description}
        </p>

        <!-- 4. 보조 설명 -->
        {subDescription && (
          <p class="text-xs sm:text-sm xl:text-sm text-[#5C5549] font-normal leading-relaxed">
            {subDescription}
          </p>
        )}

        <!-- 5-A. 모바일 전용 앵커 링크 (< lg) -->
        {mobileAnchorCta && (
          <div class="pt-1 block lg:hidden">
            <a
              href={mobileAnchorCta.href}
              class="inline-flex items-center gap-1 min-h-[44px] py-2 text-xs font-medium text-[#4F5844] hover:text-[#3E443B] underline underline-offset-4 decoration-[#E7D9C1] hover:decoration-[#4F5844] transition-colors active:scale-95"
              aria-label={mobileAnchorCta.ariaLabel || mobileAnchorCta.text}
            >
              <span>{mobileAnchorCta.text}</span>
            </a>
          </div>
        )}

        <!-- 5-B. PC 전용 CTA 버튼 (>= lg) -->
        <div class="pt-2 hidden lg:flex flex-row items-center gap-3 flex-wrap">
          <a
            href={primaryCta.href}
            class="px-5 py-3 xl:px-6 xl:py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-xs xl:text-sm hover:bg-[#3E443B] transition-colors shadow-sm inline-flex items-center justify-center gap-2 active:scale-95 shrink-0"
            aria-label={primaryCta.ariaLabel || primaryCta.text}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{primaryCta.text}</span>
          </a>

          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="px-4 py-3 xl:px-5 xl:py-3.5 rounded-md text-[#5C5549] hover:text-[#3E443B] hover:bg-[#FAF8F5] transition-colors text-xs xl:text-sm text-center border border-[#E7D9C1] bg-[#FAF8F5]/90 font-medium shrink-0"
              aria-label={secondaryCta.ariaLabel || secondaryCta.text}
            >
              {secondaryCta.text}
            </a>
          )}
        </div>

        {note && (
          <p class="text-[11px] lg:text-xs text-[#5C5549]/90 lg:text-[#5C5549]/80 pt-0.5 lg:pt-1 leading-normal">
            {note}
          </p>
        )}
      </div>

      <!-- 우측 대형 실사 이미지 영역 (>= lg) -->
      <div class="hidden lg:block col-span-6 xl:col-span-7 h-[480px] xl:h-[540px] w-full rounded-2xl overflow-hidden shadow-xs relative select-none">
        <img
          src={bgImage}
          alt={bgAlt}
          class="w-full h-full object-cover object-[center_30%] transition-transform duration-700"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
