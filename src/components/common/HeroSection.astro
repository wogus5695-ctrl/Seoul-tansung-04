---
import { SITE_CONTACT, SITE_IMAGES } from '../../data/siteConfig';

export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface HeroCta {
  text: string;
  href: string;
  ariaLabel?: string;
}

interface Props {
  bgImage?: string;
  bgAlt?: string;
  badge: string;
  h1: string;
  description: string;
  subDescription?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  note?: string;
  breadcrumbs?: BreadcrumbItem[];
  class?: string;
}

const {
  bgImage = SITE_IMAGES.defaultHeroBg,
  bgAlt = SITE_IMAGES.defaultHeroAlt,
  badge,
  h1,
  description,
  subDescription,
  primaryCta = {
    text: `전화 상담하기 (${SITE_CONTACT.phone})`,
    href: SITE_CONTACT.telHref,
    ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
  },
  secondaryCta,
  note,
  breadcrumbs,
  class: className = '',
} = Astro.props;
---

<section
  class:list={[
    'relative w-full overflow-hidden border-b border-[#E7D9C1]/70 bg-[#FAF8F5]',
    className,
  ]}
>
  <!-- 01. 배경 이미지 영역 (실제 시공 사진) -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <img
      src={bgImage}
      alt={bgAlt}
      class="w-full h-full object-cover object-[center_35%] sm:object-[right_center] scale-100 transition-transform duration-700"
      loading="eager"
      fetchpriority="high"
    />
    <!-- 02. 가독성 확보 그라데이션 오버레이 -->
    <!-- 모바일: 텍스트 대비 향상을 위해 전체 소프트 틴트 + 좌측 블렌딩 -->
    <!-- PC: 좌측 텍스트 영역 밀도 높은 화이트/아이보리 베이스에서 우측 창호/시공면으로 부드럽게 감쇄 -->
    <div
      class="absolute inset-0 bg-[#FAF8F5]/85 sm:bg-transparent sm:bg-gradient-to-r sm:from-[#FAF8F5] sm:via-[#FAF8F5]/90 sm:to-[#FAF8F5]/20 backdrop-blur-[1px] sm:backdrop-blur-none"
      aria-hidden="true"
    ></div>
    <!-- 상하단 헤더/섹션 경계 소프트 비네팅 -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/40 via-transparent to-[#FAF8F5]/60 pointer-events-none"
      aria-hidden="true"
    ></div>
  </div>

  <!-- 03. 전면 오버레이 컨텐츠 -->
  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 lg:py-20">
    <!-- Breadcrumb (지역 상세페이지용) -->
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="breadcrumb" class="mb-4 sm:mb-6 text-xs text-[#5C5549] flex items-center flex-wrap gap-2">
        {breadcrumbs.map((item, idx) => (
          <>
            {idx > 0 && <span class="text-[#5C5549]/60">/</span>}
            {item.url ? (
              <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                {item.name}
              </a>
            ) : (
              <span class="font-semibold text-[#3E443B]">{item.name}</span>
            )}
          </>
        ))}
      </nav>
    )}

    <!-- Hero 텍스트 블록 (최대 폭 제한으로 가독성 최적화) -->
    <div class="max-w-2xl space-y-4 sm:space-y-5 text-left">
      <!-- 브랜드 상단 배지 -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E7D9C1]/70 backdrop-blur-xs text-[11px] sm:text-xs font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
        <span>{badge}</span>
      </div>

      <!-- 단일 H1 메인 타이틀 -->
      <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-bold text-[#3E443B] tracking-tight leading-[1.25]">
        {h1}
      </h1>

      <!-- 메인 핵심 설명문 -->
      <p class="text-base sm:text-lg text-[#3E443B] font-medium leading-relaxed">
        {description}
      </p>

      <!-- 보조 설명문 (선택) -->
      {subDescription && (
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed max-w-lg">
          {subDescription}
        </p>
      )}

      <!-- CTA 버튼 영역 -->
      <div class="pt-2 flex flex-wrap gap-3 sm:gap-4 items-center">
        <!-- 1차 CTA: 전화 상담 -->
        <a
          href={primaryCta.href}
          class="w-full sm:w-auto px-6 py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-sm hover:bg-[#3E443B] transition-colors shadow-sm inline-flex items-center justify-center gap-2 active:scale-95"
          aria-label={primaryCta.ariaLabel || primaryCta.text}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>{primaryCta.text}</span>
        </a>

        <!-- 2차 CTA: 시공 전·후 안내 보기 (선택) -->
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="w-full sm:w-auto px-4 py-3.5 rounded-md text-[#5C5549] hover:text-[#3E443B] hover:bg-[#FAF8F5] transition-colors text-xs sm:text-sm text-center border border-[#E7D9C1] bg-[#FAF8F5]/80 backdrop-blur-xs font-medium"
            aria-label={secondaryCta.ariaLabel || secondaryCta.text}
          >
            {secondaryCta.text}
          </a>
        )}

        <!-- 보조 안내 문구 (선택) -->
        {note && (
          <span class="text-xs text-[#5C5549]/80 block w-full sm:w-auto">
            {note}
          </span>
        )}
      </div>
    </div>
  </div>
</section>
