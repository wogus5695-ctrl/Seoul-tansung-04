---
import { SITE_CONTACT, SITE_IMAGES } from '../../data/siteConfig';

export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface HeroCta {
  text: string;
  href: string;
  ariaLabel?: string;
}

export interface AnchorLink {
  text: string;
  href: string;
  ariaLabel?: string;
}

interface Props {
  bgImage?: string;
  bgAlt?: string;
  badge: string;
  h1: string;
  description: string;
  subDescription?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  mobileAnchorCta?: AnchorLink;
  note?: string;
  breadcrumbs?: BreadcrumbItem[];
  class?: string;
}

const {
  bgImage = SITE_IMAGES.defaultHeroBg,
  bgAlt = SITE_IMAGES.defaultHeroAlt,
  badge,
  h1,
  description,
  subDescription,
  primaryCta = {
    text: `전화 상담하기 (${SITE_CONTACT.phone})`,
    href: SITE_CONTACT.telHref,
    ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
  },
  secondaryCta,
  mobileAnchorCta = {
    text: '벽면 상태 확인 ↓',
    href: '#wall-check',
    ariaLabel: '벽면 상태 확인 섹션으로 이동',
  },
  note,
  breadcrumbs,
  class: className = '',
} = Astro.props;
---

<section
  class:list={[
    'relative w-full border-b border-[#E7D9C1]/70 bg-[#FAF8F5] overflow-hidden',
    className,
  ]}
>
  {/* ============================================================== */}
  {/* [1] 모바일 전용 HERO (< lg) : 배경 이미지 + 상단 집중 소프트 그라데이션 */}
  {/* ============================================================== */}
  <div class="block lg:hidden relative w-full min-h-[630px] sm:min-h-[660px] flex flex-col justify-between overflow-hidden">
    <!-- 배경 이미지: 실제 현장사진의 창호, 벽면, 천장 질감이 자연스럽게 노출되도록 배치 -->
    <div class="absolute inset-0 z-0 select-none pointer-events-none">
      <img
        src={bgImage}
        alt={bgAlt}
        class="w-full h-full object-cover object-[center_30%] scale-100"
        loading="eager"
        fetchpriority="high"
      />
      <!-- 상단 40% 텍스트 영역 집중 오버레이 (0~40%: 텍스트 가독성 확보, 40~65%: 점진 감쇄, 65~100%: 원본 노출) -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/95 via-[#FAF8F5]/85 via-40% to-transparent pointer-events-none"
        aria-hidden="true"
      ></div>
    </div>

    <!-- 상단 텍스트 콘텐츠 (순서: Badge -> H1 -> 주요 설명 -> 보조 설명 -> 작은 앵커 링크) -->
    <div class="relative z-10 w-full px-5 pt-8 sm:pt-10 pb-4 space-y-3.5 text-left">
      <!-- Breadcrumb (상세페이지 전용) -->
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav aria-label="breadcrumb" class="mb-2 text-xs text-[#5C5549] flex items-center flex-wrap gap-1.5">
          {breadcrumbs.map((item, idx) => (
            <>
              {idx > 0 && <span class="text-[#5C5549]/50">/</span>}
              {item.url ? (
                <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                  {item.name}
                </a>
              ) : (
                <span class="font-semibold text-[#3E443B]">{item.name}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <!-- 1. 영문 Badge -->
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E7D9C1]/80 text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
          {badge}
        </span>
      </div>

      <!-- 2. 단일 H1 메인 타이틀 -->
      <h1 class="text-2xl sm:text-3xl font-bold text-[#3E443B] tracking-tight leading-snug">
        {h1}
      </h1>

      <!-- 3. 주요 설명 (font-weight 완화, 자연스러운 행간) -->
      <p class="text-sm sm:text-base text-[#3E443B] font-normal leading-relaxed">
        {description}
      </p>

      <!-- 4. 보조 설명 (Regular 수준, 가독성 확보) -->
      {subDescription && (
        <p class="text-xs sm:text-sm text-[#5C5549] font-normal leading-relaxed">
          {subDescription}
        </p>
      )}

      <!-- 5. 모바일 전용 작은 앵커 링크 (벽면 상태 확인 ↓, 터치 영역 44px 이상 확보) -->
      {mobileAnchorCta && (
        <div class="pt-1">
          <a
            href={mobileAnchorCta.href}
            class="inline-flex items-center gap-1 min-h-[44px] py-2 text-xs font-medium text-[#4F5844] hover:text-[#3E443B] underline underline-offset-4 decoration-[#E7D9C1] hover:decoration-[#4F5844] transition-colors active:scale-95"
            aria-label={mobileAnchorCta.ariaLabel || mobileAnchorCta.text}
          >
            <span>{mobileAnchorCta.text}</span>
          </a>
        </div>
      )}

      {note && (
        <p class="text-[11px] text-[#5C5549]/90 pt-0.5 leading-normal">
          {note}
        </p>
      )}
    </div>

    <!-- 하단 공간 여백: 65~100% 구간 실제 사진의 창호와 벽면 질감이 선명하게 드러나도록 확보 -->
    <div class="relative z-10 h-48 sm:h-56 pointer-events-none" aria-hidden="true"></div>
  </div>

  {/* ============================================================== */}
  {/* [2] PC 전용 HERO (>= lg) : 2열 구조 (좌측 텍스트 45% / 우측 대형 실사 55%) */}
  {/* ============================================================== */}
  <div class="hidden lg:block relative w-full max-w-7xl mx-auto px-8 lg:px-12 py-12 lg:py-16">
    <div class="grid grid-cols-12 gap-8 lg:gap-10 xl:gap-14 items-center min-h-[520px] xl:min-h-[560px]">
      <!-- 좌측 텍스트 컬럼 (수직 균형 정렬) -->
      <div class="col-span-6 xl:col-span-5 space-y-4 xl:space-y-5 text-left flex flex-col justify-center">
        <!-- Breadcrumb (상세페이지 전용) -->
        {breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="breadcrumb" class="text-xs text-[#5C5549] flex items-center flex-wrap gap-2">
            {breadcrumbs.map((item, idx) => (
              <>
                {idx > 0 && <span class="text-[#5C5549]/60">/</span>}
                {item.url ? (
                  <a href={item.url} class="hover:underline hover:text-[#3E443B] transition-colors">
                    {item.name}
                  </a>
                ) : (
                  <span class="font-semibold text-[#3E443B]">{item.name}</span>
                )}
              </>
            ))}
          </nav>
        )}

        <!-- 1. 영문 Badge -->
        <div>
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#E7D9C1]/70 text-xs font-semibold text-[#5C5549] tracking-wider uppercase border border-[#E7D9C1]">
            {badge}
          </span>
        </div>

        <!-- 2. 단일 H1 메인 타이틀 -->
        <h1 class="text-3xl xl:text-4xl font-bold text-[#3E443B] tracking-tight leading-[1.25]">
          {h1}
        </h1>

        <!-- 3. 주요 설명 (font-weight 완화: Regular/Normal) -->
        <p class="text-base xl:text-lg text-[#3E443B] font-normal leading-relaxed">
          {description}
        </p>

        <!-- 4. 보조 설명 (Regular 수준, 자연스러운 행간) -->
        {subDescription && (
          <p class="text-xs xl:text-sm text-[#5C5549] font-normal leading-relaxed">
            {subDescription}
          </p>
        )}

        <!-- 5. PC CTA 버튼 영역 (가로 배치 side-by-side, 크기/간격 조절) -->
        <div class="pt-2 flex flex-row items-center gap-3 flex-wrap">
          <!-- 1차 CTA: 전화 상담하기 -->
          <a
            href={primaryCta.href}
            class="px-5 py-3 xl:px-6 xl:py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-xs xl:text-sm hover:bg-[#3E443B] transition-colors shadow-sm inline-flex items-center justify-center gap-2 active:scale-95 shrink-0"
            aria-label={primaryCta.ariaLabel || primaryCta.text}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>{primaryCta.text}</span>
          </a>

          <!-- 2차 CTA: 시공 전·후 안내 보기 (선택) -->
          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="px-4 py-3 xl:px-5 xl:py-3.5 rounded-md text-[#5C5549] hover:text-[#3E443B] hover:bg-[#FAF8F5] transition-colors text-xs xl:text-sm text-center border border-[#E7D9C1] bg-[#FAF8F5]/90 font-medium shrink-0"
              aria-label={secondaryCta.ariaLabel || secondaryCta.text}
            >
              {secondaryCta.text}
            </a>
          )}
        </div>

        {note && (
          <p class="text-xs text-[#5C5549]/80 pt-1 leading-normal">
            {note}
          </p>
        )}
      </div>

      <!-- 우측 대형 실사 이미지 영역 (약 55% : 12컬럼 중 6~7컬럼) -->
      <!-- 불필요한 테두리/오버레이 제거, 원본 색감과 공간감(창호, 벽면, 천장) 100% 보존 -->
      <div class="col-span-6 xl:col-span-7 h-[480px] xl:h-[540px] w-full rounded-2xl overflow-hidden shadow-xs relative select-none">
        <img
          src={bgImage}
          alt={bgAlt}
          class="w-full h-full object-cover object-[center_30%] transition-transform duration-700"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
