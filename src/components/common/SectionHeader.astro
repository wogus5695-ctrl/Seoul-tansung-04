---
interface Props {
  label?: string;
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
  align?: 'left' | 'center';
  size?: 'default' | 'large';
  class?: string;
}

const {
  label,
  title,
  description,
  theme = 'light',
  align = 'left',
  size = 'default',
  class: className = '',
} = Astro.props;

const isDark = theme === 'dark';
const isCenter = align === 'center';
const isLarge = size === 'large';

const labelClasses = isDark
  ? 'text-[11px] font-semibold text-[#E7D9C1]/80 tracking-wider uppercase'
  : 'text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase';

const titleClasses = [
  'font-bold tracking-tight',
  isLarge ? 'text-xl sm:text-3xl' : 'text-xl sm:text-2xl',
  isDark ? 'text-[#F5F3EE]' : 'text-[#3E443B]',
].join(' ');

const descClasses = [
  'text-xs sm:text-sm leading-relaxed',
  isDark ? 'text-[#E7D9C1]/90' : 'text-[#5C5549]',
  isCenter ? 'text-pretty' : '',
].filter(Boolean).join(' ');
---

<div class:list={[
  'space-y-1.5 sm:space-y-2 max-w-2xl',
  isCenter ? 'text-center mx-auto' : 'text-left',
  className,
]}>
  {label && <p class={labelClasses}>{label}</p>}
  <h2 class={titleClasses}>{title}</h2>
  {description && <p class={descClasses}>{description}</p>}
  <slot />
</div>
