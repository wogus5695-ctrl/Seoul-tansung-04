---
import { SITE_CONTACT } from '../../data/siteConfig';

interface Props {
  variant?: 'main' | 'district';
  id?: string;
  badge?: string;
  keyword?: string;
  title?: string;
  description?: string;
  buttonLabel?: string;
  checklistTitle?: string;
  checklist?: string[];
  notice?: string;
  class?: string;
}

const {
  variant = 'district',
  id = 'consultation',
  badge: _badge,
  keyword = '서울 탄성코트',
  title,
  description,
  buttonLabel,
  checklistTitle: _checklistTitle,
  checklist: _checklist,
  notice: _notice,
  class: className = '',
} = Astro.props;

const isMain = variant === 'main';

// 메인페이지 기본 H2 문구: {동적키워드}, 전문가와 상담하세요!
const mainTitle = title || `${keyword}, 전문가와 상담하세요!`;

// 메인페이지 기본 설명문
const mainDescription =
  description ||
  '벽면 상태를 확인할 수 있는 사진과 작업할 공간의 수, 시공 지역을 알려주시면 보다 빠르게 상담을 안내해 드릴 수 있습니다.';
---

{isMain ? (
  <section
    id={id || 'consultation'}
    class:list={[
      'w-full py-12 sm:py-16 lg:py-20 bg-[#2D322A] text-[#F5F3EE] border-t border-[#3E443B]',
      className,
    ]}
  >
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* PC: 좌측 7열 (제목 + 설명) / 우측 5열 (세로형 CTA 2개) | MO: 상단 제목+설명 -> 하단 세로형 CTA 2개 */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        {/* 좌측 텍스트 영역 (PC 7열) */}
        <div class="lg:col-span-7 space-y-3 sm:space-y-4 text-left">
          {/* 영문 라벨 완전 제거, 글자 크기 약 1.5배 확대 */}
          <h2 class="text-[26px] sm:text-3xl md:text-4xl lg:text-[42px] font-bold text-[#F5F3EE] tracking-tight leading-tight text-balance">
            {mainTitle}
          </h2>
          <p class="text-xs sm:text-sm text-[#E7D9C1]/90 leading-relaxed max-w-xl">
            {mainDescription}
          </p>
        </div>

        {/* 우측 CTA 영역 (PC 5열) */}
        <div class="lg:col-span-5 flex flex-col gap-3 sm:gap-3.5 w-full max-w-md mx-auto lg:ml-auto lg:mr-0">
          {/* CTA 01: 전화 상담 연결 (주요 버튼 - 브랜드 그린) */}
          <a
            href={SITE_CONTACT.telHref}
            class="w-full min-h-[50px] sm:min-h-[54px] px-6 py-3.5 sm:py-4 rounded-xl bg-[#4F5844] text-[#F5F3EE] font-bold text-sm sm:text-base hover:bg-[#3E443B] transition-colors shadow-md border border-[#A3B18A]/30 flex items-center justify-center gap-2.5 active:scale-98 select-none"
            aria-label={`대표 전화 상담 연결 ${SITE_CONTACT.phone}`}
          >
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>전화 상담 연결</span>
          </a>

          {/* CTA 02: 카카오톡 채널 문의 (보조 버튼 - 밝은 크림/베이지) */}
          <a
            href={SITE_CONTACT.kakaoChannelUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full min-h-[50px] sm:min-h-[54px] px-6 py-3.5 sm:py-4 rounded-xl bg-[#FAF8F5] text-[#2D322A] font-bold text-sm sm:text-base hover:bg-[#EBE7DF] hover:border-[#3E443B]/40 transition-colors shadow-md border border-[#E7D9C1] flex items-center justify-center gap-2.5 active:scale-98 select-none"
            aria-label="카카오톡 채널 문의 (새 창 열림)"
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 3c-5.52 0-10 3.58-10 8 0 2.87 1.88 5.39 4.73 6.77l-1.2 4.41c-.1.38.31.69.65.49l5.19-3.46c.21.01.42.02.63.02 5.52 0 10-3.58 10-8s-4.48-8-10-8z"/>
            </svg>
            <span>카카오톡 채널 문의</span>
          </a>
        </div>

      </div>
    </div>
  </section>
) : (
  <section class:list={['p-6 sm:p-8 rounded-2xl bg-[#4F5844] text-[#F5F3EE] space-y-4 text-center sm:text-left', className]}>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5">
        <h2 class="text-lg sm:text-xl font-bold tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-[#F5F3EE]/80 leading-relaxed">
          {description}
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a
          href={SITE_CONTACT.telHref}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#FAF8F5] text-[#3E443B] font-bold text-xs sm:text-sm hover:bg-[#F5F3EE] transition-colors shadow-sm"
        >
          <span>{buttonLabel || `전화 상담 (${SITE_CONTACT.phone})`}</span>
        </a>
      </div>
    </div>
  </section>
)}
