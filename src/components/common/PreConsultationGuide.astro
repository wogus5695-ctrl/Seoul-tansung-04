---
interface GuideItem {
  num: string;
  title: string;
  descriptionHtml: string;
}

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const GUIDE_ITEMS: GuideItem[] = [
  {
    num: '01',
    title: '시공이 필요한 공간',
    descriptionHtml:
      '<strong class="font-semibold text-[#2D322A]">베란다, 세탁실, 다용도실</strong> 등 어느 공간의 시공을 원하시는지 알려주세요.',
  },
  {
    num: '02',
    title: '기존 벽면 상태',
    descriptionHtml:
      '<strong class="font-semibold text-[#2D322A]">도막 들뜸, 곰팡이, 균열, 습기 흔적</strong> 등 현재 벽면 상태를 확인해 주세요.',
  },
  {
    num: '03',
    title: '현장사진 준비',
    descriptionHtml:
      '<strong class="font-semibold text-[#2D322A]">공간 전체 사진, 문제 부위 사진</strong>이 있다면 상담 시 함께 알려주세요. (사진은 필수 제출 사항이 아닙니다.)',
  },
  {
    num: '04',
    title: '대략적인 작업 범위',
    descriptionHtml:
      '벽면 <strong class="font-semibold text-[#2D322A]">전체 시공</strong>인지 <strong class="font-semibold text-[#2D322A]">일부 구간 보수</strong>인지 희망하시는 작업 범위를 알려주세요.',
  },
  {
    num: '05',
    title: '현장 내부 작업 조건',
    descriptionHtml:
      '세탁기, 건조기, 수납장 등 <strong class="font-semibold text-[#2D322A]">이동이나 보양이 필요한 물품</strong>이 있는지 확인해 주세요.',
  },
  {
    num: '06',
    title: '시공 지역 및 희망 일정',
    descriptionHtml:
      '서울 내 <strong class="font-semibold text-[#2D322A]">시공 지역</strong>과 <strong class="font-semibold text-[#2D322A]">희망 작업 시기</strong>를 알려주시면 상담에 큰 도움이 됩니다.',
  },
];
---

<section
  id="spaces"
  class:list={['w-full py-12 sm:py-16 bg-[#F5F3EE] border-b border-[#E7D9C1]', className]}
>
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* PC: 좌측 대표 이미지(5열) + 우측 6개 안내 리스트(7열) / MO: 상단 이미지 + 하단 리스트 순차 배치 */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      {/* 1. 실제 현장사진 (PC: 좌측 / MO: 상단) */}
      <div class="lg:col-span-5 flex flex-col justify-start">
        <div class="relative w-full rounded-xl sm:rounded-2xl overflow-hidden border border-[#E7D9C1] bg-[#FAF8F5] shadow-xs aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[460px]">
          <picture class="block w-full h-full">
            <source srcset="/images/sections/pre-consultation-guide.webp" type="image/webp" />
            <img
              src="/images/sections/pre-consultation-guide.jpg"
              alt="기존 벽면 마감재가 들뜨고 벗겨진 시공 전 현장"
              class="w-full h-full object-cover object-center select-none"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </picture>
        </div>
      </div>

      {/* 2. 섹션 제목 / 설명문 / 6개 안내 항목 (PC: 우측 / MO: 하단) */}
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        
        {/* 헤더: 영문 라벨 제거, 신규 H2 및 설명문 */}
        <div class="space-y-2 sm:space-y-2.5 text-left">
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#3E443B]">
            상담 전, 아래 내용을 확인해 주세요!
          </h2>
          <div class="text-xs sm:text-sm text-[#5C5549] leading-relaxed space-y-1">
            <p>미리 확인할 수 있는 정보만 알려주셔도 좋습니다.</p>
            <p class="text-[#5C5549]/80">
              벽면 상태와 작업 범위를 파악해 보다 원활하게 상담을 진행할 수 있습니다.
            </p>
          </div>
        </div>

        {/* 6개 항목 간결한 리스트형 레이아웃 */}
        <div class="divide-y divide-[#E7D9C1]/70 border-y border-[#E7D9C1]/70">
          {GUIDE_ITEMS.map((item) => (
            <div class="py-3 sm:py-3.5 flex items-start gap-3 sm:gap-3.5 text-left">
              {/* 번호 뱃지 */}
              <span class="w-6 h-6 rounded-full bg-[#FAF8F5] border border-[#E7D9C1] text-[#4F5844] font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs select-none">
                {item.num}
              </span>

              {/* 제목 및 핵심 강조 설명 */}
              <div class="space-y-0.5 flex-1 min-w-0">
                <h3 class="text-sm sm:text-base font-bold text-[#3E443B]">
                  {item.title}
                </h3>
                <p
                  class="text-xs sm:text-[13px] text-[#5C5549] leading-relaxed"
                  set:html={item.descriptionHtml}
                />
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>
