---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceholderImage from '../../../components/common/PlaceholderImage.astro';
import { getPublishedSeoPages, getRegionById, getServiceById, SEO_PAGES, type SeoPageConfig } from '../../../data/pages';

export async function getStaticPaths() {
  // isPublished === true인 페이지만 정적 경로 생성
  const publishedPages = getPublishedSeoPages();
  return publishedPages.map((page) => ({
    params: {
      service: page.serviceSlug,
      district: page.districtSlug,
    },
    props: {
      page,
    },
  }));
}

interface Props {
  page: SeoPageConfig;
}

const { page } = Astro.props;
const region = getRegionById(page.regionId);
const service = getServiceById(page.serviceId);
const content = page.content;

// 관련 공개 페이지 목록 (동일 지역 타 서비스 또는 타 지역 공개 페이지)
const relatedPublishedPages = SEO_PAGES.filter(
  (p) => p.isPublished && p.id !== page.id
);
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  path={page.urlPath}
>
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12 sm:space-y-16 text-left">
    <!-- 02. Breadcrumb (네비게이션 경로) -->
    <nav aria-label="breadcrumb" class="text-xs text-[#5C5549] flex items-center flex-wrap gap-2">
      <a href="/" class="hover:underline hover:text-[#3E443B]">홈</a>
      <span>/</span>
      <span class="text-[#5C5549]">서울권 시공 안내</span>
      <span>/</span>
      <span class="font-semibold text-[#3E443B]">{region?.name} {service?.name}</span>
    </nav>

    <!-- 03. Local Hero Section -->
    <header class="space-y-4 max-w-3xl border-b border-[#E7D9C1]/60 pb-8 sm:pb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E7D9C1]/50 text-[11px] sm:text-xs font-semibold text-[#5C5549] tracking-wider uppercase">
        <span>ALLCARE SEOUL · {region?.displayName}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#3E443B] tracking-tight leading-tight">
        {page.h1}
      </h1>
      <p class="text-sm sm:text-base text-[#5C5549] leading-relaxed">
        {page.heroCopy}
      </p>
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a
          href="tel:01084926900"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-xs sm:text-sm hover:bg-[#3E443B] transition-colors shadow-sm active:scale-95"
          aria-label="대표 전화 상담 바로 연결"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>전화 상담 문의 (010-8492-6900)</span>
        </a>
        <span class="text-xs text-[#5C5549]/80">※ 현장 사진을 문자로 보내주시면 빠른 확인이 가능합니다.</span>
      </div>
    </header>

    <!-- 04. 시공 대상 공간 안내 (Target Spaces) -->
    {content?.targetSpaces && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">TARGET SPACES</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            {region?.name} 시공 대상 공간 안내
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            공간별 습기 유입 경로와 환경에 따라 중점적으로 확인해야 할 사항입니다.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
          {content.targetSpaces.map((item, idx) => (
            <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/60 text-[#3E443B] font-bold text-xs flex items-center justify-center">
                  {idx + 1}
                </span>
                <h3 class="text-base font-bold text-[#3E443B]">{item.title}</h3>
              </div>
              <p class="text-xs font-semibold text-[#4F5844]">{item.subtitle}</p>
              <p class="text-xs text-[#5C5549] leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 05. 시공 전 벽면 상태 확인 (Wall Conditions) -->
    {content?.wallConditions && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">WALL CONDITION CHECK</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            시공 전 벽면 상태 자가 진단
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            탄성코트 도포 전 벽면의 기본 바탕 상태를 확인하여 전처리 방식을 결정합니다.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {content.wallConditions.map((item) => (
            <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-[#4F5844]">{item.num}</span>
                <h3 class="text-sm sm:text-base font-bold text-[#3E443B]">{item.title}</h3>
              </div>
              <p class="text-xs text-[#5C5549] leading-relaxed">
                {item.description}
              </p>
              <details class="pt-1.5 text-xs text-[#5C5549] border-t border-[#E7D9C1]/60 group/detail">
                <summary class="cursor-pointer text-[11px] font-semibold text-[#4F5844] hover:underline flex items-center justify-between select-none">
                  <span>작업 안내</span>
                  <span class="text-[9px] group-open/detail:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-1.5 leading-relaxed text-[#5C5549]/80">
                  {item.detail}
                </p>
              </details>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 06. 작업 범위 확인 가이드 (Scope Factors) -->
    {content?.scopeFactors && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">SCOPE FACTORS</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            작업 범위와 견적에 영향을 주는 실제 조건
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            단순 평형뿐만 아니라 현장의 벽체 바탕면 상태에 따라 공정 소요 시간이 달라집니다.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
          {content.scopeFactors.map((item) => (
            <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
              <h3 class="text-sm sm:text-base font-bold text-[#3E443B]">{item.title}</h3>
              <div class="space-y-1.5 text-xs">
                <div>
                  <span class="font-semibold text-[#4F5844] block">현장 조건:</span>
                  <p class="text-[#5C5549] leading-relaxed">{item.condition}</p>
                </div>
                <div class="pt-1 border-t border-[#E7D9C1]/40">
                  <span class="font-semibold text-[#4F5844] block">시공 영향:</span>
                  <p class="text-[#5C5549] leading-relaxed">{item.impact}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 현장 사진 등록 안내 (플레이스홀더 영역) -->
    <section class="space-y-4">
      <div class="space-y-1.5 max-w-2xl">
        <h2 class="text-lg sm:text-xl font-bold text-[#3E443B]">현장 시공 사진 준비</h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          올케어탄성은 신뢰할 수 있는 정품 시공을 위해 승인된 실제 현장 사진만을 등록합니다.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <PlaceholderImage
          label="시공 전 바탕면 사진 등록 예정"
          subLabel="현장 검증 후 실제 시공 전 벽면 상태 이미지가 등록됩니다."
        />
        <PlaceholderImage
          label="시공 후 세라믹 마감 사진 등록 예정"
          subLabel="현장 검증 후 실제 시공 후 균일 도막 이미지가 등록됩니다."
        />
      </div>
    </section>

    <!-- 07. 상담 전 확인할 사항 (Consultation Prep) -->
    {content?.consultationPreps && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">HOW TO PREPARE</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            상담 전 사진 접수 안내
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            아래 4가지 항목을 확인하여 사진을 보내주시면 신속하고 정직하게 안내해 드립니다.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          {content.consultationPreps.map((item) => (
            <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] flex gap-3.5 items-start">
              <span class="w-7 h-7 rounded-full bg-[#4F5844] text-[#F5F3EE] font-mono font-bold text-xs flex items-center justify-center shrink-0">
                {item.num}
              </span>
              <div class="space-y-1 text-left">
                <h3 class="text-sm font-bold text-[#3E443B]">{item.title}</h3>
                <p class="text-xs text-[#5C5549] leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 08. 시공 진행 안내 (Process) -->
    {content?.processSteps && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">WORK PROCESS</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            올케어 표준 시공 과정
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            현장 방문부터 밑작업, 도포, 양생 확인까지 정석 절차를 준수합니다.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {content.processSteps.map((item) => (
            <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-1.5">
              <span class="text-[10px] font-mono font-bold text-[#4F5844] block">{item.step}</span>
              <h3 class="text-sm font-bold text-[#3E443B]">{item.title}</h3>
              <p class="text-xs text-[#5C5549] leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 09. FAQ 5문항 -->
    {content?.faqs && (
      <section class="space-y-6">
        <div class="space-y-1.5 max-w-2xl">
          <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">FREQUENTLY ASKED QUESTIONS</p>
          <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
            {region?.name} 시공 관련 자주 묻는 질문
          </h2>
          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
            상담 전 가장 많이 궁금해하시는 사항을 투명하게 안내해 드립니다.
          </p>
        </div>

        <div class="space-y-3 max-w-3xl">
          {content.faqs.map((faq, idx) => (
            <details class="group p-4 sm:p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] transition-colors">
              <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
                <span class="leading-snug">Q{idx + 1}. {faq.question}</span>
                <span class="text-[#4F5844] text-xs transition-transform group-open:rotate-180 shrink-0">▼</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-[#E7D9C1]/60 text-xs text-[#5C5549] leading-relaxed space-y-1.5">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 10. 관련 지역 및 서비스 안내 (내부 링크 구조) -->
    <section class="space-y-4 pt-4 border-t border-[#E7D9C1]/60">
      <h2 class="text-base font-bold text-[#3E443B]">서비스 지역 및 관련 안내</h2>
      <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-3">
        <p class="text-xs text-[#5C5549] leading-relaxed">
          {page.serviceScopeNotice}
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
          <a href="/" class="font-semibold text-[#4F5844] hover:underline flex items-center gap-1">
            <span>&larr; 서울 전체 시공 안내 (홈으로)</span>
          </a>
          {relatedPublishedPages.map((relPage) => (
            <a
              href={relPage.urlPath}
              class="font-semibold text-[#4F5844] hover:underline"
            >
              {relPage.h1} &rarr;
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. 최종 전화 상담 CTA -->
    <section class="p-6 sm:p-8 rounded-2xl bg-[#4F5844] text-[#F5F3EE] space-y-4 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1.5">
          <h2 class="text-lg sm:text-xl font-bold tracking-tight">
            {region?.name} 탄성코트 시공 사진 상담
          </h2>
          <p class="text-xs sm:text-sm text-[#F5F3EE]/80 leading-relaxed">
            베란다와 세탁실의 벽면 사진을 보내주시면 작업 범위와 시공 일정을 친절히 안내합니다.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="tel:01084926900"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#FAF8F5] text-[#3E443B] font-bold text-xs sm:text-sm hover:bg-[#F5F3EE] transition-colors shadow-sm"
          >
            <span>전화 상담 (010-8492-6900)</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
