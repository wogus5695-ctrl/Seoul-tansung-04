---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/common/SectionHeader.astro';
import FaqAccordion from '../../../components/common/FaqAccordion.astro';
import ConsultationBanner from '../../../components/common/ConsultationBanner.astro';
import HeroSection from '../../../components/common/HeroSection.astro';
import WallCheckSection from '../../../components/common/WallCheckSection.astro';
import { SITE_CONTACT } from '../../../data/siteConfig';
import { getPublishedSeoPages, getRegionById, getServiceById, SEO_PAGES, isPagePublished, type SeoPageConfig } from '../../../data/pages';
import { getSiteUrl, getCanonicalUrl, buildWebPageJsonLd, buildBreadcrumbJsonLd } from '../../../utils/seo';

export async function getStaticPaths() {
  // isPublished === true && contentStatus === 'approved'인 페이지만 정적 경로 생성
  const publishedPages = getPublishedSeoPages();
  return publishedPages.map((page) => ({
    params: {
      service: page.serviceSlug,
      district: page.districtSlug,
    },
    props: {
      page,
    },
  }));
}

interface Props {
  page: SeoPageConfig;
}

const { page } = Astro.props;
const region = getRegionById(page.regionId);
const service = getServiceById(page.serviceId);
const content = page.content;

// 관련 공개 페이지 목록 (공개 승인된 동일 지역 타 서비스 또는 타 지역 공개 페이지)
const relatedPublishedPages = SEO_PAGES.filter(
  (p) => isPagePublished(p) && p.id !== page.id
);

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl(page.urlPath, siteUrl);

const breadcrumbItems = siteUrl ? [
  { name: '홈', url: `${siteUrl}/` },
  { name: `${region?.name ?? ''} ${service?.name ?? ''}`, url: canonicalUrl || '' },
] : [];

const jsonLd = siteUrl ? [
  buildWebPageJsonLd(page.metaTitle, page.metaDescription, canonicalUrl),
  buildBreadcrumbJsonLd(breadcrumbItems),
] : [];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  path={page.urlPath}
  jsonLd={jsonLd}
>
  <!-- 01. Hero Section (공통 HeroSection 컴포넌트 적용) -->
  <HeroSection
    badge={`ALLCARE SEOUL · ${region?.displayName ?? ''}`}
    h1={page.h1}
    description={page.heroCopy}
    primaryCta={{
      text: `전화 상담 문의 (${SITE_CONTACT.phone})`,
      href: SITE_CONTACT.telHref,
      ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
    }}
    note="※ 전화 상담 시 필요한 사진과 전달 방법을 안내받으실 수 있습니다."
    breadcrumbs={[
      { name: '홈', url: '/' },
      { name: '서울권 시공 안내' },
      { name: `${region?.name ?? ''} ${service?.name ?? ''}` },
    ]}
  />

  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12 sm:space-y-16 text-left">

    <!-- 04. 시공 대상 공간 안내 (Target Spaces) -->
    {content?.targetSpaces && (
      <section class="space-y-6">
        <SectionHeader
          label="TARGET SPACES"
          title={`${region?.name ?? ''} 시공 대상 공간 안내`}
          description="공간별 습기 유입 경로와 환경에 따라 중점적으로 확인해야 할 사항입니다."
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
          {content.targetSpaces.map((item, idx) => (
            <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/60 text-[#3E443B] font-bold text-xs flex items-center justify-center">
                  {idx + 1}
                </span>
                <h3 class="text-base font-bold text-[#3E443B]">{item.title}</h3>
              </div>
              <p class="text-xs font-semibold text-[#4F5844]">{item.subtitle}</p>
              <p class="text-xs text-[#5C5549] leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 05. 시공 전 벽면 상태 확인 (공감형 카피 + 이미지 삽입형 레이아웃 개선) -->
    <WallCheckSection
      keyword={service?.name || '탄성코트'}
      variant="card"
    />

    <!-- 06. 작업 범위 확인 가이드 (Scope Factors) -->
    {content?.scopeFactors && (
      <section class="space-y-6">
        <SectionHeader
          label="SCOPE FACTORS"
          title="작업 범위와 견적에 영향을 주는 실제 조건"
          description="공간 면적뿐만 아니라 현장의 벽체 바탕면 상태와 작업 환경에 따라 준비 범위가 달라집니다."
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
          {content.scopeFactors.map((item) => (
            <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
              <h3 class="text-sm sm:text-base font-bold text-[#3E443B]">{item.title}</h3>
              <div class="space-y-1.5 text-xs">
                <div>
                  <span class="font-semibold text-[#4F5844] block">현장 조건:</span>
                  <p class="text-[#5C5549] leading-relaxed">{item.condition}</p>
                </div>
                <div class="pt-1 border-t border-[#E7D9C1]/40">
                  <span class="font-semibold text-[#4F5844] block">시공 영향:</span>
                  <p class="text-[#5C5549] leading-relaxed">{item.impact}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 07. 상담 전 확인할 사항 (Consultation Prep) -->
    {content?.consultationPreps && (
      <section class="space-y-6">
        <SectionHeader
          label="HOW TO PREPARE"
          title="전화 상담 전 확인 사항"
          description="아래 사항을 미리 확인하여 사진을 준비해 주시면 전화 상담 시 현장 상태를 설명하는 데 도움이 됩니다."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          {content.consultationPreps.map((item) => (
            <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] flex gap-3.5 items-start">
              <span class="w-7 h-7 rounded-full bg-[#4F5844] text-[#F5F3EE] font-mono font-bold text-xs flex items-center justify-center shrink-0">
                {item.num}
              </span>
              <div class="space-y-1 text-left">
                <h3 class="text-sm font-bold text-[#3E443B]">{item.title}</h3>
                <p class="text-xs text-[#5C5549] leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 08. 시공 진행 안내 (Process) -->
    {content?.processSteps && (
      <section class="space-y-6">
        <SectionHeader
          label="WORK PROCESS"
          title="탄성코트 시공 과정 안내"
          description="현장 확인부터 보양, 바탕면 정리, 도포, 양생 안내까지의 일반적인 작업 흐름입니다."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {content.processSteps.map((item) => (
            <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-1.5">
              <span class="text-[10px] font-mono font-bold text-[#4F5844] block">{item.step}</span>
              <h3 class="text-sm font-bold text-[#3E443B]">{item.title}</h3>
              <p class="text-xs text-[#5C5549] leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 09. FAQ 5문항 -->
    {content?.faqs && (
      <section class="space-y-6">
        <SectionHeader
          title={`${region?.name ?? ''} 시공 관련 자주 묻는 질문`}
          description={`${region?.name ?? ''} ${service?.name ?? '탄성코트'} 시공을 알아보실 때 자주 묻는 질문 5가지를 정리했습니다. 궁금한 항목을 선택해 확인해 보세요.`}
        />

        <FaqAccordion items={content.faqs} variant="district" />
      </section>
    )}

    <!-- 10. 관련 지역 및 서비스 안내 (내부 링크 구조) -->
    <section class="space-y-4 pt-4 border-t border-[#E7D9C1]/60">
      <h2 class="text-base font-bold text-[#3E443B]">서비스 지역 및 관련 안내</h2>
      <div class="p-4 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-3">
        <p class="text-xs text-[#5C5549] leading-relaxed">
          {page.serviceScopeNotice}
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
          <a href="/" class="font-semibold text-[#4F5844] hover:underline flex items-center gap-1">
            <span>&larr; 서울 전체 시공 안내 (홈으로)</span>
          </a>
          {relatedPublishedPages.map((relPage) => (
            <a
              href={relPage.urlPath}
              class="font-semibold text-[#4F5844] hover:underline"
            >
              {relPage.h1} &rarr;
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. 최종 전화 상담 CTA -->
    <ConsultationBanner
      variant="district"
      title={`${region?.name ?? ''} ${service?.name ?? ''} 시공 상담 안내`}
      description="벽면 상태와 작업 공간에 대해 문의해 주시면 필요한 작업 범위와 일정을 안내해 드립니다."
      buttonLabel={`전화 상담 (${SITE_CONTACT.phone})`}
    />
  </div>
</BaseLayout>
