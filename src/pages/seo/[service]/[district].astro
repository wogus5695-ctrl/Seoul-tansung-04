---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/common/SectionHeader.astro';
import FaqAccordion from '../../../components/common/FaqAccordion.astro';
import ConsultationBanner from '../../../components/common/ConsultationBanner.astro';
import HeroSection from '../../../components/common/HeroSection.astro';
import WallCheckSection from '../../../components/common/WallCheckSection.astro';
import BeforeAfterGallery from '../../../components/common/BeforeAfterGallery.astro';
import PreConsultationGuide from '../../../components/common/PreConsultationGuide.astro';
import ProcessTimeline from '../../../components/common/ProcessTimeline.astro';
import DistrictPointsSection from '../../../components/common/DistrictPointsSection.astro';
import { SITE_CONTACT } from '../../../data/siteConfig';
import { getPublishedSeoPages, getRegionById, getDongById, getServiceById, SEO_PAGES, isPagePublished, type SeoPageConfig } from '../../../data/pages';
import { getSiteUrl, getCanonicalUrl, buildWebPageJsonLd, buildBreadcrumbJsonLd } from '../../../utils/seo';

export async function getStaticPaths() {
  // isPublished === true && contentStatus === 'approved'인 페이지만 정적 경로 생성
  const publishedPages = getPublishedSeoPages();
  return publishedPages.map((page) => ({
    params: {
      service: page.serviceSlug,
      district: page.districtSlug,
    },
    props: {
      page,
    },
  }));
}

interface Props {
  page: SeoPageConfig;
}

const { page } = Astro.props;
const region = page.regionLevel === 'dong' ? getDongById(page.regionId) : getRegionById(page.regionId);
const service = getServiceById(page.serviceId);
const content = page.content;

// 관련 공개 페이지 목록 (공개 승인된 동일 지역 타 서비스 또는 타 지역 공개 페이지)
const relatedPublishedPages = SEO_PAGES.filter(
  (p) => isPagePublished(p) && p.id !== page.id
);

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl(page.urlPath, siteUrl);

const breadcrumbItems = siteUrl ? [
  { name: '홈', url: `${siteUrl}/` },
  { name: `${region?.name ?? ''} ${service?.name ?? ''}`, url: canonicalUrl || '' },
] : [];

const jsonLd = siteUrl ? [
  buildWebPageJsonLd(page.metaTitle, page.metaDescription, canonicalUrl),
  buildBreadcrumbJsonLd(breadcrumbItems),
] : [];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  path={page.urlPath}
  jsonLd={jsonLd}
  image={page.ogImage}
  imageAlt={page.ogImageAlt}
  imageWidth={page.ogImageWidth}
  imageHeight={page.ogImageHeight}
>
  {/* 01. Hero Section (공통 HeroSection 컴포넌트 적용) */}
  <HeroSection
    badge={`ALLCARE SEOUL · ${region?.displayName ?? ''}`}
    h1={page.h1}
    description={page.heroCopy}
    primaryCta={{
      text: `전화 상담 문의 (${SITE_CONTACT.phone})`,
      href: SITE_CONTACT.telHref,
      ariaLabel: `대표 전화 상담 바로 연결 ${SITE_CONTACT.phone}`,
    }}
    mobileAnchorCta={{
      text: "벽면 상태 확인 ↓",
      href: "#wall-check",
      ariaLabel: "벽면 상태 확인 섹션으로 이동"
    }}
    note="※ 전화 상담 시 필요한 사진과 전달 방법을 안내받으실 수 있습니다."
    breadcrumbs={[
      { name: '홈', url: '/' },
      { name: '서울권 시공 안내' },
      { name: `${region?.name ?? ''} ${service?.name ?? ''}` },
    ]}
  />

  {/* 02. 올케어 작업 현장 (실제 시공 전후 사진 자동 슬라이드 갤러리) */}
  <section id="before-after" class="w-full pt-10 pb-16 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      <SectionHeader
        title="올케어 작업 현장"
        description="오래되고 얼룩진 공간, 시공 전·후 달라진 모습을 직접 확인해보세요."
      />

      <BeforeAfterGallery />
    </div>
  </section>

  {/* 03. 벽면 상태 확인 (메인 다크 섹션) */}
  <WallCheckSection
    keyword={service?.name || '탄성코트'}
    variant="full"
  />

  {/* 04. 지역·작업별 시공 확인 포인트 (고유 콘텐츠: targetSpaces + scopeFactors) */}
  <DistrictPointsSection
    keyword={`${region?.name ?? ''} ${service?.name ?? '탄성코트'}`}
    regionName={region?.name}
    title={`${region?.name ?? ''} ${service?.name ?? '탄성코트'} 시공 전 확인할 사항`}
    targetSpaces={content?.targetSpaces}
    scopeFactors={content?.scopeFactors}
  />

  {/* 05. 상담 전 안내 (메인 사진형 레이아웃 + 지역 고유 준비 항목 보존) */}
  {content?.consultationPreps && (
    <PreConsultationGuide
      title="상담 전, 아래 내용을 확인해 주세요!"
      description="미리 확인할 수 있는 정보만 알려주셔도 좋습니다."
      subDescription="벽면 상태와 작업 범위를 파악해 보다 원활하게 상담을 진행할 수 있습니다."
      items={content.consultationPreps}
    />
  )}

  {/* 06. 시공 과정 (메인 타임라인 + 지역 고유 단계 정보 보존) */}
  {content?.processSteps && (
    <ProcessTimeline
      keyword={service?.name || '탄성코트'}
      title={`${service?.name || '탄성코트'} 시공 과정 안내`}
      description="현장 확인부터 보양, 바탕면 정리, 도포, 양생 안내까지의 일반적인 작업 흐름입니다."
      steps={content.processSteps.map((s) => ({
        step: s.step,
        title: s.title,
        description: s.description,
      }))}
    />
  )}

  {/* 07. 자주 묻는 질문 (메인 FAQ 디자인 + 지역 고유 5문항 원문 보존) */}
  {content?.faqs && (
    <section id="faq" class="w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
      <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <SectionHeader
          title={`${region?.name ?? ''} 시공 관련 자주 묻는 질문`}
          description={`${region?.name ?? ''} ${service?.name ?? '탄성코트'} 시공을 알아보실 때 자주 묻는 질문 5가지를 정리했습니다. 궁금한 항목을 선택해 확인해 보세요.`}
        />

        <FaqAccordion items={content.faqs} variant="main" />
      </div>
    </section>
  )}

  {/* 08. 관련 지역 및 서비스 안내 (내부 링크 구조 - 공개 페이지 한정) */}
  <section class="w-full py-10 sm:py-12 bg-[#F5F3EE] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-left">
      <h2 class="text-base sm:text-lg font-bold text-[#3E443B]">서비스 지역 및 관련 안내</h2>
      <div class="p-4 sm:p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-3">
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          {page.serviceScopeNotice}
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs sm:text-sm">
          <a href="/" class="font-semibold text-[#4F5844] hover:underline flex items-center gap-1">
            <span>&larr; 서울 전체 시공 안내 (홈으로)</span>
          </a>
          {relatedPublishedPages.map((relPage) => (
            <a
              href={relPage.urlPath}
              class="font-semibold text-[#4F5844] hover:underline"
            >
              {relPage.h1} &rarr;
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* 09. FINAL CONSULTATION CTA (전화 + 카카오톡 채널) */}
  <ConsultationBanner
    variant="main"
    title={`${region?.name ?? ''} ${service?.name ?? '탄성코트'}, 전문가에게 상담하세요!`}
    description="실제 시공 공간과 벽면 상태를 사진으로 알려주시면 필요한 작업 범위와 일정을 보다 빠르게 안내받으실 수 있습니다."
  />
</BaseLayout>
