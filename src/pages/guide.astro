---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultationBanner from '../components/common/ConsultationBanner.astro';
import { getPublishedGuides } from '../data/guides.ts';
import { SITE_CONTACT } from '../data/siteConfig.ts';
import { getSiteUrl, getCanonicalUrl, buildWebPageJsonLd, buildBreadcrumbJsonLd } from '../utils/seo.ts';

// 승인 및 공개된 게시글만 최신순으로 정렬
const publishedGuides = getPublishedGuides().sort((a, b) => {
  const dateA = new Date(a.publishedAt || 0).getTime();
  const dateB = new Date(b.publishedAt || 0).getTime();
  return dateB - dateA;
});

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl('/guide.html', siteUrl);

const pageTitle = '탄성코트 시공 정보 | 올케어탄성';
const pageDescription = '탄성코트 시공 전 확인할 벽면 상태, 작업 준비사항과 관리 정보를 안내합니다.';

const breadcrumbItems = siteUrl ? [
  { name: '홈', url: `${siteUrl}/` },
  { name: '시공 정보', url: canonicalUrl || '' },
] : [];

const jsonLd = siteUrl ? [
  buildWebPageJsonLd(pageTitle, pageDescription, canonicalUrl),
  buildBreadcrumbJsonLd(breadcrumbItems),
] : [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/guide.html"
  jsonLd={jsonLd}
>
  <!-- 페이지 상단 헤더 영역 -->
  <section class="w-full bg-[#FAF8F5] border-b border-[#E7D9C1]/60 py-10 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <!-- Breadcrumb 네비게이션 -->
      <nav aria-label="브레드크럼" class="flex items-center justify-center sm:justify-start text-xs text-[#7A7265] mb-4 space-x-2">
        <a href="/" class="hover:text-[#2C5E43] transition-colors">홈</a>
        <span class="text-gray-400">/</span>
        <span class="text-[#3E443B] font-medium">시공 정보</span>
      </nav>

      <span class="inline-block px-3 py-1 bg-[#2C5E43]/10 text-[#2C5E43] text-xs font-bold rounded-full mb-3 tracking-wide">
        ALLCARE GUIDE
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#3E443B] tracking-tight leading-snug">
        탄성코트 시공 정보
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#5C5549] max-w-2xl leading-relaxed">
        탄성코트 시공 전 확인할 벽면 상태, 작업 준비사항과 관리 정보를 안내합니다.
      </p>
    </div>
  </section>

  <!-- 게시글 목록 본문 영역 -->
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    {publishedGuides.length > 0 ? (
      <div class="space-y-6">
        {publishedGuides.map((guide) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-white border border-[#E7D9C1] hover:border-[#2C5E43]/60 transition-all duration-200 shadow-sm hover:shadow-md text-left">
            <div class="flex items-center justify-between gap-4 mb-2">
              <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-[#FAF8F5] text-[#2C5E43] border border-[#E7D9C1]/60">
                시공 가이드
              </span>
              {guide.publishedAt && (
                <time datetime={guide.publishedAt} class="text-xs text-[#7A7265]">
                  {guide.publishedAt.split('T')[0]}
                </time>
              )}
            </div>

            <h2 class="text-lg sm:text-xl font-bold text-[#3E443B] leading-snug hover:text-[#2C5E43] transition-colors">
              <a href={`/guide/${guide.slug}.html`} class="focus:outline-none focus:underline">
                {guide.title}
              </a>
            </h2>

            <p class="mt-2.5 text-xs sm:text-sm text-[#5C5549] leading-relaxed line-clamp-2">
              {guide.description}
            </p>

            <div class="mt-4 pt-4 border-t border-[#FAF8F5] flex items-center justify-between">
              <span class="text-xs text-[#7A7265]">올케어탄성 기술팀</span>
              <a
                href={`/guide/${guide.slug}.html`}
                class="inline-flex items-center text-xs sm:text-sm font-semibold text-[#2C5E43] hover:text-[#1E4230] transition-colors"
                aria-label={`${guide.title} 전문 읽기`}
              >
                자세히 읽기
                <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="p-8 sm:p-12 rounded-2xl bg-[#FAF8F5] border border-[#E7D9C1] text-center space-y-4">
        <div class="w-12 h-12 mx-auto rounded-full bg-[#E7D9C1]/50 flex items-center justify-center text-[#2C5E43]">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-[#3E443B]">
          시공 정보 콘텐츠 준비 중입니다
        </h3>
        <p class="text-xs sm:text-sm text-[#5C5549] max-w-md mx-auto leading-relaxed">
          베란다 결로 및 곰팡이 방지 탄성코트 시공 가이드를 순차적으로 등록할 예정입니다. 궁금하신 사항은 대표 번호로 문의해 주시기 바랍니다.
        </p>
        <div class="pt-2">
          <a
            href={SITE_CONTACT.telHref}
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-[#2C5E43] text-white text-xs sm:text-sm font-semibold hover:bg-[#1E4230] transition-colors shadow-sm"
          >
            전화 상담 문의 ({SITE_CONTACT.phone})
          </a>
        </div>
      </div>
    )}
  </main>

  <!-- 하단 공통 상담 배너 -->
  <ConsultationBanner
    variant="district"
    keyword="탄성코트 시공 정보"
    title="탄성코트 시공 전 궁금한 점이 있으신가요?"
    description="작업할 공간의 벽면 사진을 보내주시면 현장 상태를 확인하고 필요한 작업 범위를 친절하게 안내해 드립니다."
  />
</BaseLayout>
