---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/common/HeroSection.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import BeforeAfterGallery from '../components/common/BeforeAfterGallery.astro';
import WallCheckSection from '../components/common/WallCheckSection.astro';
import PreConsultationGuide from '../components/common/PreConsultationGuide.astro';
import ProcessTimeline from '../components/common/ProcessTimeline.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import ConsultationBanner from '../components/common/ConsultationBanner.astro';
import { REGIONS } from '../data/regions';
import { SEO_PAGES, isPagePublished } from '../data/pages';
import { getSiteUrl, getCanonicalUrl, buildWebSiteJsonLd, buildWebPageJsonLd } from '../utils/seo';

// 메인 페이지 전용 FAQ 5문항 데이터
const MAIN_FAQS = [
  {
    question: 'Q1. 시공 전에 벽면 상태를 먼저 확인하는 이유가 무엇인가요?',
    answer: '같은 아파트, 같은 평형이라도 환기 습관과 외벽 접합 여부에 따라 벽면 상태가 완전히 다릅니다. 단순히 페인트를 덧바르는 것이 아니라 기존 도막 들뜸이나 곰팡이 오염도를 미리 확인해야 그에 맞는 스크래핑과 퍼티 보수 등 필수 전처리를 결정할 수 있기 때문입니다.',
  },
  {
    question: 'Q2. 기존 페인트가 들뜨거나 부푼 경우 어떻게 작업하나요?',
    answer: '들뜨거나 부푼 기존 페인트 위에 바로 도포하면 얼마 지나지 않아 함께 떨어질 수 있습니다. 따라서 스크래퍼 장비로 부실한 도막을 깨끗이 긁어낸 뒤, 퍼티로 단차를 맞추고 하도 작업을 거쳐 탄성코트를 도포합니다.',
  },
  {
    question: 'Q3. 베란다와 세탁실은 점검할 때 어떤 차이가 있나요?',
    answer: '베란다는 외부 창호와 맞닿아 있어 결로와 일조량, 외부 온도 차이에 따른 창가 주변 실금 점검이 중요합니다. 반면 세탁실은 물 사용과 가전 배치로 습도가 높기 쉬우므로, 배관 주변 습기 자국과 가전 뒤편 사각지대 곰팡이를 집중 점검합니다.',
  },
  {
    question: 'Q4. 시공 비용과 작업 범위를 결정하는 기준은 무엇인가요?',
    answer: '올케어탄성은 지역명만으로 획일적인 가격을 책정하지 않습니다. 시공 대상 공간 개수(베란다, 세탁실, 실외기실 등)와 면적, 기존 벽면의 들뜸·곰팡이 면적에 따른 전처리 작업 난이도를 종합 검토하여 꼭 필요한 작업 범위에 맞추어 합리적인 비용을 안내합니다.',
  },
  {
    question: 'Q5. 상담할 때 미리 준비하면 좋은 정보나 사진이 있나요?',
    answer: '시공을 희망하시는 공간의 전체 구도가 보이는 사진 1~2장과, 도막 들뜸이나 곰팡이, 균열이 보이는 부위의 근접 사진을 함께 준비해 주시면 현장 방문 전에도 대략적인 바탕면 상태와 작업 범위를 훨씬 빠르고 정확하게 안내받으실 수 있습니다.',
  },
];


// 각 지역별 공개 상세 페이지 매핑 (isPublished=true && contentStatus='approved'만 연결)
// 향후 특정 지역의 페이지가 공식 승인/공개되면 해당 링크가 자동 연동되는 구조
const regionStatusList = REGIONS.map((region) => {
  const publishedPages = SEO_PAGES.filter(
    (page) => page.regionId === region.id && isPagePublished(page)
  );
  return {
    ...region,
    isPublished: publishedPages.length > 0,
    publishedLinks: publishedPages.map((p) => ({
      name: p.serviceSlug === 'balcony-elastic-coating' ? '베란다탄성코트' : '탄성코트',
      url: p.urlPath,
    })),
  };
});

const pageTitle = "서울 탄성코트 시공 안내 | 올케어탄성";
const pageDescription = "서울권 베란다와 세탁실의 탄성코트 시공을 안내합니다. 기존 도막, 균열, 습기 흔적 등 벽면 상태와 필요한 작업 범위를 확인하고 상담받을 수 있습니다.";
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl('/', siteUrl);

const jsonLd = siteUrl ? [
  buildWebSiteJsonLd(siteUrl),
  buildWebPageJsonLd(pageTitle, pageDescription, canonicalUrl),
] : [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  jsonLd={jsonLd}
>
  <!-- 02. HERO SECTION (실제 시공 사진 배경 + 텍스트 오버레이 구조) -->
  <HeroSection
    badge="ALLCARE ELASTIC COATING · 서울권"
    h1="서울 탄성코트 전문 시공, 올케어탄성"
    description="베란다·세탁실 벽면에 들뜸이나 얼룩이 보이시나요?"
    subDescription="기존 도막과 균열·습기 흔적을 살펴보고, 필요한 시공 범위를 안내합니다."
    primaryCta={{
      text: "전화 상담하기 (010-8492-6900)",
      href: "tel:01084926900",
      ariaLabel: "대표 전화 상담 바로 연결 010-8492-6900"
    }}
    secondaryCta={{
      text: "시공 전·후 안내 보기",
      href: "#before-after",
      ariaLabel: "시공 전·후 안내 섹션으로 이동"
    }}
    mobileAnchorCta={{
      text: "벽면 상태 확인 ↓",
      href: "#wall-check",
      ariaLabel: "벽면 상태 확인 섹션으로 이동"
    }}
  />

  <!-- 03. 실제 작업 현장 / BEFORE & AFTER (실제 현장사진 2초 자동 슬라이드 갤러리) -->
  <section id="before-after" class="w-full pt-10 pb-16 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      <SectionHeader
        title="올케어 작업 현장"
        description="오래되고 얼룩진 공간, 시공 전·후 달라진 모습을 직접 확인해보세요."
      />

      <BeforeAfterGallery />
    </div>
  </section>

  <!-- 04. 벽면 상태 확인 (공감형 카피 + 이미지 삽입형 레이아웃 개선) -->
  <WallCheckSection keyword="탄성코트" />

  <!-- 05. 상담 전 안내 (상담 전 확인 6개 항목 + 실제 현장사진 적용) -->
  <PreConsultationGuide />

  <!-- 06. 시공 과정 (타임라인형 UI/문구 개편) -->
  <ProcessTimeline keyword="탄성코트" />

  <!-- 07. 서울 지역별 시공 안내 (반복 배지 제거 & 간결한 12개 자치구 목록) -->
  <section id="regions" class="w-full py-12 sm:py-16 bg-[#F5F3EE] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <SectionHeader
        title="서울 지역별 시공 안내"
        description="서울 탄성코트 시공 상담을 안내합니다. 아래 12개 자치구를 확인하시고, 실제 작업 가능 범위와 일정은 상담을 통해 확인해 주세요."
      />

      <!-- 12개 자치구 목록 그리드 (반복 배지 제거, 컴팩트 2열/4열 배치, 텍스트 충돌 방지) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3">
        {regionStatusList.map((item) => (
          item.isPublished ? (
            <div class="p-3 rounded-lg bg-[#FAF8F5] border border-[#4F5844]/40 hover:border-[#4F5844] transition-all text-left space-y-1">
              <span class="text-xs sm:text-sm font-bold text-[#3E443B] block">{item.name}</span>
              <div class="flex flex-wrap gap-1.5 pt-0.5">
                {item.publishedLinks.map((link) => (
                  <a
                    href={link.url}
                    class="text-[11px] font-semibold text-[#4F5844] hover:underline"
                  >
                    {link.name} &rarr;
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div class="p-3 rounded-lg bg-[#FAF8F5] border border-[#E7D9C1] text-left flex items-center justify-between">
              <span class="text-xs sm:text-sm font-semibold text-[#3E443B]">{item.name}</span>
              <span class="text-[10px] text-[#5C5549]/70 font-mono">서울</span>
            </div>
          )
        ))}
      </div>

      <p class="text-[11px] text-[#5C5549]/70 text-left">
        ※ 위 12개 자치구를 포함하여 서울 전역 상담이 가능합니다. 현장 사진을 보내주시면 시공 가능 범위를 안내해 드립니다.
      </p>
    </div>
  </section>

  <!-- 08. FAQ (Q4 불균형 해소 & 일관된 화살표 간격) -->
  <section id="faq" class="w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <SectionHeader
        title="자주 묻는 질문 (FAQ)"
        description="서울 탄성코트 시공을 알아보실 때 자주 묻는 질문 5가지를 정리했습니다. 궁금한 항목을 선택해 확인해 보세요."
      />

      <!-- FAQ 아코디언 리스트 -->
      <FaqAccordion items={MAIN_FAQS} variant="main" />
    </div>
  </section>

  <!-- 09. FINAL CONSULTATION CTA (동적키워드 기반 전화/카카오톡 2개 채널 배너) -->
  <ConsultationBanner
    variant="main"
    keyword="서울 탄성코트"
  />
</BaseLayout>
