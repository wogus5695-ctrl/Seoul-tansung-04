---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/common/PlaceholderImage.astro';
import { REGIONS } from '../data/regions';
import { SEO_PAGES, isPagePublished } from '../data/pages';

// 실제 시공 사진 보유 여부 플래그 (현재 미확보 상태이므로 false)
// 향후 실제 현장 사진 등록 시 true로 전환하면 2열 Before & After 비교 레이아웃이 자동 활성화됩니다.
const hasRealPhotos = false;

// 각 지역별 공개 상세 페이지 매핑 (isPublished=true && contentStatus='approved'만 연결)
// 향후 특정 지역의 페이지가 공식 승인/공개되면 해당 링크가 자동 연동되는 구조
const regionStatusList = REGIONS.map((region) => {
  const publishedPages = SEO_PAGES.filter(
    (page) => page.regionId === region.id && isPagePublished(page)
  );
  return {
    ...region,
    isPublished: publishedPages.length > 0,
    publishedLinks: publishedPages.map((p) => ({
      name: p.serviceSlug === 'balcony-elastic-coating' ? '베란다탄성코트' : '탄성코트',
      url: p.urlPath,
    })),
  };
});
---

<BaseLayout
  title="서울 탄성코트 시공 안내 | 올케어탄성"
  description="서울권 베란다와 세탁실의 탄성코트 시공을 안내합니다. 기존 도막, 균열, 습기 흔적 등 벽면 상태와 필요한 작업 범위를 확인하고 상담받을 수 있습니다."
  path="/"
>
  <!-- 02. HERO SECTION -->
  <section class="w-full py-10 sm:py-16 lg:py-20 border-b border-[#E7D9C1]/60">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- 히어로 카피 & CTA (모바일에서 텍스트와 CTA 우선 배치) -->
        <div class="lg:col-span-7 space-y-5 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E7D9C1]/50 text-[11px] sm:text-xs font-semibold text-[#5C5549] tracking-wider uppercase">
            <span>ALLCARE ELASTIC COATING · 서울권</span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-bold text-[#3E443B] tracking-tight leading-[1.25]">
            서울 탄성코트 전문 시공, 올케어탄성
          </h1>

          <p class="text-base sm:text-lg text-[#3E443B] font-medium leading-relaxed">
            베란다·세탁실 벽면이 들뜨거나 얼룩졌나요?<br class="hidden sm:inline" />
            벽면 상태를 확인하고 필요한 시공 범위를 안내합니다.
          </p>

          <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed max-w-lg">
            도막 들뜸, 곰팡이 흔적, 미세 균열 등 기존 벽면 상태를 먼저 살펴보고 꼭 필요한 작업 범위부터 정직하게 상담해 드립니다.
          </p>

          <!-- 주요 CTA & 보조 CTA -->
          <div class="pt-1 flex flex-wrap gap-3 sm:gap-4 items-center">
            <a
              href="tel:01084926900"
              class="w-full sm:w-auto px-6 py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-semibold text-sm hover:bg-[#3E443B] transition-colors shadow-sm inline-flex items-center justify-center gap-2"
              aria-label="대표 전화 상담 바로 연결 010-8492-6900"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <span>전화 상담하기 (010-8492-6900)</span>
            </a>

            <a
              href="#before-after"
              class="w-full sm:w-auto px-4 py-3 rounded-md text-[#5C5549] hover:text-[#3E443B] hover:bg-[#FAF8F5] transition-colors text-xs sm:text-sm text-center border border-[#E7D9C1]"
            >
              시공 전·후 안내 보기
            </a>
          </div>
        </div>

        <!-- 히어로 비주얼 (중립적 플레이스홀더, 최적화된 높이) -->
        <div class="lg:col-span-5 w-full">
          <PlaceholderImage
            label="주거 공간 시공 현장 안내"
            subLabel="실제 시공 완료된 베란다·세탁실 사진이 등록될 예정입니다."
            aspectRatio="aspect-[16/10] sm:aspect-[4/3]"
            class="shadow-sm"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 03. 실제 작업 현장 / BEFORE & AFTER (사진 미확보 상태: 컴팩트 안내 박스로 최적화) -->
  <section id="before-after" class="w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="space-y-2 max-w-2xl text-left">
        <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">
          FIELDWORK PREVIEW
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
          시공 전·후 현장사진
        </h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          실제 시공 현장사진을 비교하여 확인하실 수 있도록 준비 중입니다.
        </p>
      </div>

      {hasRealPhotos ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-[#E7D9C1] bg-[#F5F3EE] p-6 sm:p-8 text-center max-w-xl mx-auto space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#FAF8F5] border border-[#E7D9C1] flex items-center justify-center text-[#5C5549] mx-auto">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
          </div>
          <div class="space-y-1">
            <p class="text-sm font-bold text-[#3E443B]">실제 시공 현장사진 준비 중</p>
            <p class="text-xs text-[#5C5549] leading-relaxed">
              시공 전·후 모습을 비교할 수 있도록 실제 현장사진을 순차적으로 등록할 예정입니다.
            </p>
          </div>
          <p class="text-[11px] text-[#5C5549]/70 pt-1">
            가상 이미지나 스톡 사진을 일절 사용하지 않으며 검증된 현장 사진만 등록합니다.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- 04. 벽면 상태 확인 (핵심 설명 항상 표시 + 상세 확인 접힘 기능 적용) -->
  <section id="wall-check" class="w-full py-12 sm:py-16 bg-[#2D322A] text-[#F5F3EE] border-b border-[#3E443B]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-2 text-left">
        <p class="text-[11px] font-semibold text-[#E7D9C1]/80 tracking-wider uppercase">
          WALL CONDITION CHECK
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#F5F3EE] tracking-tight">
          벽면 상태 확인 포인트
        </h2>
        <p class="text-xs sm:text-sm text-[#E7D9C1]/90 leading-relaxed">
          같은 탄성코트 시공이라도 기존 벽면 상태에 따라 필요한 전처리 작업과 시공 범위가 달라집니다.
        </p>
      </div>

      <!-- 4개 체크 포인트 그리드 (컴팩트 카드 + 세부 확인사항 접힘) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 01 도막 들뜸 -->
        <div class="p-4 rounded-xl bg-[#3E443B]/60 border border-[#E7D9C1]/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#E7D9C1]">01</span>
            <h3 class="text-sm sm:text-base font-bold text-[#F5F3EE]">도막 들뜸</h3>
          </div>
          <p class="text-xs text-[#E7D9C1]/90 leading-relaxed">
            페인트가 부풀거나 가루처럼 벗겨지는 상태입니다.
          </p>
          <details class="pt-1.5 text-xs text-[#E7D9C1]/80 border-t border-[#E7D9C1]/15 group/detail">
            <summary class="cursor-pointer text-[11px] font-semibold text-[#A3B18A] hover:underline flex items-center justify-between select-none">
              <span>상세 확인 내용</span>
              <span class="text-[9px] group-open/detail:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-1.5 leading-relaxed text-[#E7D9C1]/75">
              기존 도막의 접착 상태를 확인하고 필요한 바탕면 정리 범위를 판단합니다.
            </p>
          </details>
        </div>

        <!-- 02 벽면 균열 -->
        <div class="p-4 rounded-xl bg-[#3E443B]/60 border border-[#E7D9C1]/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#E7D9C1]">02</span>
            <h3 class="text-sm sm:text-base font-bold text-[#F5F3EE]">벽면 균열</h3>
          </div>
          <p class="text-xs text-[#E7D9C1]/90 leading-relaxed">
            모서리나 창호 프레임 주변에 실금이 생긴 상태입니다.
          </p>
          <details class="pt-1.5 text-xs text-[#E7D9C1]/80 border-t border-[#E7D9C1]/15 group/detail">
            <summary class="cursor-pointer text-[11px] font-semibold text-[#A3B18A] hover:underline flex items-center justify-between select-none">
              <span>상세 확인 내용</span>
              <span class="text-[9px] group-open/detail:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-1.5 leading-relaxed text-[#E7D9C1]/75">
              균열 깊이와 범위를 확인한 뒤 뿜칠 전 보강 작업 여부를 결정합니다.
            </p>
          </details>
        </div>

        <!-- 03 오염 및 곰팡이 -->
        <div class="p-4 rounded-xl bg-[#3E443B]/60 border border-[#E7D9C1]/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#E7D9C1]">03</span>
            <h3 class="text-sm sm:text-base font-bold text-[#F5F3EE]">오염 · 곰팡이</h3>
          </div>
          <p class="text-xs text-[#E7D9C1]/90 leading-relaxed">
            벽면 구석이나 모서리에 거뭇한 얼룩이 생긴 상태입니다.
          </p>
          <details class="pt-1.5 text-xs text-[#E7D9C1]/80 border-t border-[#E7D9C1]/15 group/detail">
            <summary class="cursor-pointer text-[11px] font-semibold text-[#A3B18A] hover:underline flex items-center justify-between select-none">
              <span>상세 확인 내용</span>
              <span class="text-[9px] group-open/detail:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-1.5 leading-relaxed text-[#E7D9C1]/75">
              단순 표면 오염인지 벽면 내부 습기인지 확인 후 세척 및 전처리 방식을 정합니다.
            </p>
          </details>
        </div>

        <!-- 04 습기 및 결로 -->
        <div class="p-4 rounded-xl bg-[#3E443B]/60 border border-[#E7D9C1]/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#E7D9C1]">04</span>
            <h3 class="text-sm sm:text-base font-bold text-[#F5F3EE]">습기 · 결로</h3>
          </div>
          <p class="text-xs text-[#E7D9C1]/90 leading-relaxed">
            창가 주변이나 외벽 접합부에 습기 흔적이 남은 상태입니다.
          </p>
          <details class="pt-1.5 text-xs text-[#E7D9C1]/80 border-t border-[#E7D9C1]/15 group/detail">
            <summary class="cursor-pointer text-[11px] font-semibold text-[#A3B18A] hover:underline flex items-center justify-between select-none">
              <span>상세 확인 내용</span>
              <span class="text-[9px] group-open/detail:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-1.5 leading-relaxed text-[#E7D9C1]/75">
              현재 벽면 건조 상태와 계절별 환기 여건을 고려해 시공 시점을 협의합니다.
            </p>
          </details>
        </div>
      </div>

      <!-- 정직한 안내 박스 (간결화) -->
      <div class="p-3.5 sm:p-4 rounded-xl bg-[#3E443B]/90 border border-[#E7D9C1]/25 text-[11px] sm:text-xs text-[#E7D9C1]/90 leading-relaxed">
        <span class="font-semibold text-[#F5F3EE]">※ 안내 유의사항: </span>
        탄성코트는 벽면의 쾌적한 마감과 통기성 관리를 돕는 도장 시공입니다. 건물 구조적 결함이나 외벽 균열로 인한 누수는 근본적인 점검이 선행되어야 하므로, 벽면 상태부터 정직하게 확인해 드립니다.
      </div>
    </div>
  </section>

  <!-- 05. 공간별 시공 포인트 (설명 압축 & 여백 최적화) -->
  <section id="spaces" class="w-full py-12 sm:py-16 bg-[#F5F3EE] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-2 text-left">
        <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">
          RESIDENTIAL SPACES
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
          공간별 시공 포인트
        </h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          공간의 이용 형태와 배관 위치에 따라 점검해야 할 핵심 사항을 안내합니다.
        </p>
      </div>

      <!-- 3개 공간 컴팩트 카드 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
        <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/60 text-[#3E443B] font-bold text-xs flex items-center justify-center">1</span>
            <h3 class="text-base font-bold text-[#3E443B]">베란다 (발코니)</h3>
          </div>
          <p class="text-xs font-semibold text-[#4F5844]">창호 주변 벽면과 기존 도막 상태</p>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            외부 기온 변화와 일조 영향을 직접 받는 공간으로, 창가 주변 실금과 기존 페인트의 접착 상태를 우선 점검합니다.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/60 text-[#3E443B] font-bold text-xs flex items-center justify-center">2</span>
            <h3 class="text-base font-bold text-[#3E443B]">세탁실 (다용도실)</h3>
          </div>
          <p class="text-xs font-semibold text-[#4F5844]">배관 주변과 습기 흔적</p>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            물 사용량이 많아 습기가 머물기 쉬운 공간으로, 배관 주변 벽면 상태와 가전 설치 공간의 환기 여건을 확인합니다.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-[#FAF8F5] border border-[#E7D9C1] space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#E7D9C1]/60 text-[#3E443B] font-bold text-xs flex items-center justify-center">3</span>
            <h3 class="text-base font-bold text-[#3E443B]">다용도 공간 / 보일러실</h3>
          </div>
          <p class="text-xs font-semibold text-[#4F5844]">벽면 마감 상태와 작업 환경</p>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            선반 철거 흔적이나 배관 관통부 등 벽면 요철 상태를 살펴보고 고른 도막 형성을 위한 작업 여건을 점검합니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. 시공 과정 (PC/MO 반응형 타임라인 및 간결한 흐름) -->
  <section id="process" class="w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-2 text-left">
        <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">
          WORK PROCESS
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
          시공 과정
        </h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          현장 상태 점검부터 보양, 뿜칠, 마감 확인까지의 일반적인 작업 흐름입니다.
        </p>
      </div>

      <!-- 5단계 반응형 프로세스 흐름 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-3.5">
        <div class="p-4 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] space-y-1.5 text-left">
          <span class="text-[10px] font-mono font-bold text-[#4F5844] bg-[#4F5844]/10 px-2 py-0.5 rounded">
            STEP 01
          </span>
          <h3 class="text-sm font-bold text-[#3E443B]">상태 확인</h3>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            도막 들뜸, 오염 부위, 균열 크기 및 환기 여건 점검
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] space-y-1.5 text-left">
          <span class="text-[10px] font-mono font-bold text-[#4F5844] bg-[#4F5844]/10 px-2 py-0.5 rounded">
            STEP 02
          </span>
          <h3 class="text-sm font-bold text-[#3E443B]">작업 범위 안내</h3>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            벽면 상태에 맞춘 스크래핑 및 퍼티 보수 범위 안내
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] space-y-1.5 text-left">
          <span class="text-[10px] font-mono font-bold text-[#4F5844] bg-[#4F5844]/10 px-2 py-0.5 rounded">
            STEP 03
          </span>
          <h3 class="text-sm font-bold text-[#3E443B]">보양 및 준비</h3>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            창호·바닥 마스킹 보양 후 부실 도막 정리 및 퍼티 보강
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] space-y-1.5 text-left">
          <span class="text-[10px] font-mono font-bold text-[#4F5844] bg-[#4F5844]/10 px-2 py-0.5 rounded">
            STEP 04
          </span>
          <h3 class="text-sm font-bold text-[#3E443B]">탄성코트 도포</h3>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            도막 두께와 작업 환경을 고려한 탄성코트 뿜칠 도포
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] space-y-1.5 text-left">
          <span class="text-[10px] font-mono font-bold text-[#4F5844] bg-[#4F5844]/10 px-2 py-0.5 rounded">
            STEP 05
          </span>
          <h3 class="text-sm font-bold text-[#3E443B]">마감 확인 &amp; 관리</h3>
          <p class="text-xs text-[#5C5549] leading-relaxed">
            보양재 철거 후 도막 상태 검수 및 환기 양생 요령 안내
          </p>
        </div>
      </div>

      <p class="text-[11px] text-[#5C5549]/70 text-left">
        ※ 실제 소요 시간과 작업 범위는 현장 면적 및 기존 벽면 상태에 따라 달라질 수 있습니다.
      </p>
    </div>
  </section>

  <!-- 07. 서울 지역별 시공 안내 (반복 배지 제거 & 간결한 12개 자치구 목록) -->
  <section id="regions" class="w-full py-12 sm:py-16 bg-[#F5F3EE] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="space-y-2 max-w-2xl text-left">
        <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">
          SERVICE AREAS
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
          서울 지역별 시공 안내
        </h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          올케어탄성은 서울 전역의 주거 공간을 대상으로 정직한 시공 상담을 제공합니다. 현재 아래 12개 자치구를 중심으로 우선 방문 상담을 진행하고 있습니다.
        </p>
      </div>

      <!-- 12개 자치구 목록 그리드 (반복 배지 제거, 컴팩트 2열/4열 배치, 텍스트 충돌 방지) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-3">
        {regionStatusList.map((item) => (
          item.isPublished ? (
            <div class="p-3 rounded-lg bg-[#FAF8F5] border border-[#4F5844]/40 hover:border-[#4F5844] transition-all text-left space-y-1">
              <span class="text-xs sm:text-sm font-bold text-[#3E443B] block">{item.name}</span>
              <div class="flex flex-wrap gap-1.5 pt-0.5">
                {item.publishedLinks.map((link) => (
                  <a
                    href={link.url}
                    class="text-[11px] font-semibold text-[#4F5844] hover:underline"
                  >
                    {link.name} &rarr;
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div class="p-3 rounded-lg bg-[#FAF8F5] border border-[#E7D9C1] text-left flex items-center justify-between">
              <span class="text-xs sm:text-sm font-semibold text-[#3E443B]">{item.name}</span>
              <span class="text-[10px] text-[#5C5549]/70 font-mono">서울</span>
            </div>
          )
        ))}
      </div>

      <p class="text-[11px] text-[#5C5549]/70 text-left">
        ※ 위 12개 자치구를 포함하여 서울 전역 상담이 가능합니다. 현장 사진을 보내주시면 시공 가능 범위를 안내해 드립니다.
      </p>
    </div>
  </section>

  <!-- 08. FAQ (Q4 불균형 해소 & 일관된 화살표 간격) -->
  <section id="faq" class="w-full py-12 sm:py-16 bg-[#FAF8F5] border-b border-[#E7D9C1]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="space-y-2 max-w-2xl text-left">
        <p class="text-[11px] font-semibold text-[#5C5549] tracking-wider uppercase">
          FREQUENTLY ASKED QUESTIONS
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight">
          자주 묻는 질문 (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-[#5C5549] leading-relaxed">
          탄성코트 시공 전 가장 자주 문의하시는 5문항입니다. 질문을 클릭하시면 답변을 확인하실 수 있습니다.
        </p>
      </div>

      <!-- FAQ 아코디언 리스트 (초기 상태 모두 접힘, 질문과 화살표 간격 충분) -->
      <div class="space-y-3 max-w-3xl">
        <!-- Q1 -->
        <details class="group p-4 sm:p-5 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
            <span class="leading-snug">Q1. 시공 전에 벽면 상태를 먼저 확인하는 이유가 무엇인가요?</span>
            <span class="text-xs text-[#5C5549] shrink-0 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          <p class="mt-2.5 text-xs text-[#5C5549] leading-relaxed pt-2 border-t border-[#E7D9C1]">
            같은 아파트, 같은 평형이라도 환기 습관과 외벽 접합 여부에 따라 벽면 상태가 완전히 다릅니다. 단순히 페인트를 덧바르는 것이 아니라 기존 도막 들뜸이나 곰팡이 오염도를 미리 확인해야 그에 맞는 스크래핑과 퍼티 보수 등 필수 전처리를 결정할 수 있기 때문입니다.
          </p>
        </details>

        <!-- Q2 -->
        <details class="group p-4 sm:p-5 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
            <span class="leading-snug">Q2. 기존 페인트가 들뜨거나 부푼 경우 어떻게 작업하나요?</span>
            <span class="text-xs text-[#5C5549] shrink-0 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          <p class="mt-2.5 text-xs text-[#5C5549] leading-relaxed pt-2 border-t border-[#E7D9C1]">
            들뜨거나 부푼 기존 페인트 위에 바로 도포하면 얼마 지나지 않아 함께 떨어질 수 있습니다. 따라서 스크래퍼 장비로 부실한 도막을 깨끗이 긁어낸 뒤, 퍼티로 단차를 맞추고 하도 작업을 거쳐 탄성코트를 도포합니다.
          </p>
        </details>

        <!-- Q3 -->
        <details class="group p-4 sm:p-5 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
            <span class="leading-snug">Q3. 베란다와 세탁실은 점검할 때 어떤 차이가 있나요?</span>
            <span class="text-xs text-[#5C5549] shrink-0 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          <p class="mt-2.5 text-xs text-[#5C5549] leading-relaxed pt-2 border-t border-[#E7D9C1]">
            베란다는 외부 창호와 맞닿아 있어 결로와 일조량, 외부 온도 차이에 따른 창가 주변 실금 점검이 중요합니다. 반면 세탁실은 물 사용과 가전 배치로 습도가 높기 쉬우므로, 배관 주변 습기 자국과 가전 뒤편 사각지대 곰팡이를 집중 점검합니다.
          </p>
        </details>

        <!-- Q4 (보조 문구 제거, 정상 줄바꿈 및 간격 확보) -->
        <details class="group p-4 sm:p-5 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
            <span class="leading-snug">Q4. 시공 비용과 작업 범위를 결정하는 기준은 무엇인가요?</span>
            <span class="text-xs text-[#5C5549] shrink-0 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          <p class="mt-2.5 text-xs text-[#5C5549] leading-relaxed pt-2 border-t border-[#E7D9C1]">
            올케어탄성은 지역명만으로 획일적인 가격을 책정하지 않습니다. 시공 대상 공간 개수(베란다, 세탁실, 실외기실 등)와 면적, 기존 벽면의 들뜸·곰팡이 면적에 따른 전처리 작업 난이도를 종합 검토하여 꼭 필요한 작업 범위에 맞추어 합리적인 비용을 안내합니다.
          </p>
        </details>

        <!-- Q5 -->
        <details class="group p-4 sm:p-5 rounded-xl bg-[#F5F3EE] border border-[#E7D9C1] transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-[#3E443B] text-xs sm:text-sm select-none">
            <span class="leading-snug">Q5. 상담할 때 미리 준비하면 좋은 정보나 사진이 있나요?</span>
            <span class="text-xs text-[#5C5549] shrink-0 group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>
          <p class="mt-2.5 text-xs text-[#5C5549] leading-relaxed pt-2 border-t border-[#E7D9C1]">
            시공을 희망하시는 공간의 전체 구도가 보이는 사진 1~2장과, 도막 들뜸이나 곰팡이, 균열이 보이는 부위의 근접 사진을 함께 준비해 주시면 현장 방문 전에도 대략적인 바탕면 상태와 작업 범위를 훨씬 빠르고 정확하게 안내받으실 수 있습니다.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 09. FINAL CONSULTATION CTA -->
  <section id="consultation" class="w-full py-12 sm:py-20 bg-[#2D322A] text-[#F5F3EE]">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 max-w-2xl">
      <div class="space-y-2">
        <p class="text-[11px] font-semibold text-[#E7D9C1]/80 tracking-wider uppercase">
          DIRECT CONSULTATION
        </p>
        <h2 class="text-xl sm:text-3xl font-bold text-[#F5F3EE] tracking-tight">
          우리 집 벽면 상태부터 확인해보세요
        </h2>
        <p class="text-xs sm:text-sm text-[#E7D9C1]/90 leading-relaxed text-pretty">
          사진이나 현재 벽면 상태를 알려주시면 확인해야 할 부분과 필요한 작업 범위를 정직하게 상담해 드립니다.
        </p>
      </div>

      <!-- 상담 준비 체크리스트 박스 (컴팩트화) -->
      <div class="p-4 rounded-xl bg-[#3E443B]/80 border border-[#E7D9C1]/20 text-left space-y-2">
        <p class="text-[11px] font-semibold text-[#E7D9C1] tracking-wider uppercase">
          상담 시 미리 준비하면 좋은 정보
        </p>
        <ul class="text-xs text-[#E7D9C1]/90 space-y-1 list-disc list-inside">
          <li>벽면 전체 구도가 보이는 사진</li>
          <li>도막 들뜸, 곰팡이, 균열 부위의 근접 사진</li>
          <li>작업 희망 공간 (베란다, 세탁실 등)</li>
        </ul>
      </div>

      <!-- 전화 상담 메인 버튼 -->
      <div class="pt-1">
        <a
          href="tel:01084926900"
          class="w-full sm:w-auto px-7 py-3.5 rounded-md bg-[#4F5844] text-[#F5F3EE] font-bold text-sm sm:text-base hover:bg-[#3E443B] transition-colors shadow-md inline-flex items-center justify-center gap-2 active:scale-95"
          aria-label="대표 전화 상담 바로 연결 010-8492-6900"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>전화 상담 연결 (010-8492-6900)</span>
        </a>
      </div>

      <p class="text-[11px] text-[#E7D9C1]/70">
        불필요한 과잉 작업을 권하지 않고, 현재 공간에 꼭 필요한 작업 범위부터 투명하게 안내합니다.
      </p>
    </div>
  </section>
</BaseLayout>
