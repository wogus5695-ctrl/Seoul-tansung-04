---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteUrl, getCanonicalUrl, buildWebPageJsonLd, buildBreadcrumbJsonLd } from '../utils/seo.ts';
import { REGIONS } from '../data/regions.ts';
import { SERVICES } from '../data/services.ts';
import { DONGS } from '../data/dongs.ts';
import { getPublishedSeoPages, getRegionById, getDongById, type SeoPageConfig } from '../data/pages.ts';

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl('/sitemap-seoul.html', siteUrl);

const pageTitle = '서울 탄성코트 시공지역 안내 | 올케어탄성';
const pageDescription = '올케어탄성의 서울 지역별 탄성코트 및 베란다탄성코트 시공 안내를 확인하세요. 공개된 지역별 상세페이지를 작업 종류에 따라 안내합니다.';

const breadcrumbItems = siteUrl ? [
  { name: '홈', url: `${siteUrl}/` },
  { name: '서울 시공지역 안내', url: canonicalUrl || '' },
] : [];

const jsonLd = siteUrl ? [
  buildWebPageJsonLd(pageTitle, pageDescription, canonicalUrl),
  buildBreadcrumbJsonLd(breadcrumbItems),
] : [];

const publishedPages = getPublishedSeoPages();

// 부모 자치구 ID 판별 헬퍼
function getParentGuId(page: SeoPageConfig): string {
  if (page.regionLevel === 'dong') {
    return page.parentRegionId || getDongById(page.regionId)?.parentRegionId || '';
  }
  return page.regionId;
}

// 키워드명 텍스트 생성 헬퍼 (순수 키워드명만 반환)
function getKeywordText(page: SeoPageConfig): string {
  const service = SERVICES.find((s) => s.id === page.serviceId);
  const serviceName = service?.name ?? '';
  if (page.regionLevel === 'dong') {
    const dong = getDongById(page.regionId);
    return `${dong?.name ?? ''} ${serviceName}`.trim();
  }
  const region = getRegionById(page.regionId);
  return `${region?.name ?? ''} ${serviceName}`.trim();
}

// 자치구 중심 계층 구조 생성 (REGIONS 순서 유지, 미공개 자치구 자동 제외)
const guGroups = REGIONS.map((region) => {
  const guPages = publishedPages.filter((p) => getParentGuId(p) === region.id);
  if (guPages.length === 0) return null;

  // 자치구 내 서비스별 그룹 (SERVICES 순서: 탄성코트 -> 베란다탄성코트)
  const serviceGroups = SERVICES.map((service) => {
    const servicePages = guPages.filter((p) => p.serviceId === service.id);
    if (servicePages.length === 0) return null;

    // 항목 순서: 구 단위 최상단, 하위 동 단위는 DONGS 순서대로 배치
    const sortedPages = [...servicePages].sort((a, b) => {
      if (a.regionLevel !== 'dong' && b.regionLevel === 'dong') return -1;
      if (a.regionLevel === 'dong' && b.regionLevel !== 'dong') return 1;
      if (a.regionLevel === 'dong' && b.regionLevel === 'dong') {
        const dongAIdx = DONGS.findIndex((d) => d.id === a.regionId);
        const dongBIdx = DONGS.findIndex((d) => d.id === b.regionId);
        return dongAIdx - dongBIdx;
      }
      return 0;
    });

    return {
      service,
      pages: sortedPages.map((page) => ({
        urlPath: page.urlPath,
        keyword: getKeywordText(page),
      })),
    };
  }).filter((sg): sg is NonNullable<typeof sg> => sg !== null);

  return {
    region,
    serviceGroups,
  };
}).filter((g): g is NonNullable<typeof g> => g !== null);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/sitemap-seoul.html"
  jsonLd={jsonLd}
>
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- 상단 브레드크럼 및 헤더 -->
    <nav aria-label="브레드크럼" class="flex items-center text-xs text-[#7A7265] mb-4 space-x-2">
      <a href="/" class="hover:text-[#4F5844] transition-colors">홈</a>
      <span class="text-[#E7D9C1]">/</span>
      <span class="text-[#3E443B] font-medium">서울 시공지역 안내</span>
    </nav>

    <header class="border-b border-[#E7D9C1] pb-6 mb-8">
      <span class="inline-block px-3 py-1 bg-[#4F5844]/10 text-[#4F5844] text-xs font-bold rounded-full mb-3 tracking-wide">
        SITE DIRECTORY
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#3E443B] tracking-tight leading-snug">
        서울 탄성코트 시공지역 안내
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#5C5549] leading-relaxed">
        올케어탄성에서 공개한 지역별 탄성코트 및 베란다탄성코트 시공 안내 페이지를 확인할 수 있습니다.
      </p>
    </header>

    <!-- 구 단위 중심 계층형 목록 -->
    <div class="space-y-8 sm:space-y-10">
      {guGroups.map(({ region, serviceGroups }) => (
        <section aria-labelledby={`gu-heading-${region.id}`} class="rounded-2xl border border-[#E7D9C1] bg-[#FAF8F5] p-5 sm:p-7 shadow-2xs">
          <!-- 1차 그룹: 자치구 헤더 -->
          <div class="border-b border-[#E7D9C1] pb-4 mb-6 flex items-center justify-between">
            <h2 id={`gu-heading-${region.id}`} class="text-xl sm:text-2xl font-bold text-[#3E443B] tracking-tight flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#4F5844] inline-block"></span>
              <span>{region.name}</span>
            </h2>
            <span class="text-xs text-[#7A7265] font-medium">
              {region.displayName}
            </span>
          </div>

          <!-- 2차 그룹: 서비스별 목록 -->
          <div class="space-y-6">
            {serviceGroups.map(({ service, pages }) => (
              <div class="space-y-3">
                <h3 class="text-sm sm:text-base font-bold text-[#5C5549] flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-sm bg-[#8C8270] inline-block"></span>
                  <span>{service.name}</span>
                </h3>

                <!-- 링크 목록 (순수 키워드명만 표시, 반응형 단일/복수 열, 여유 있는 터치 영역) -->
                <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
                  {pages.map((page) => (
                    <li>
                      <a
                        href={page.urlPath}
                        class="flex items-center justify-between px-4 py-3 rounded-xl bg-white border border-[#E7D9C1] text-[#3E443B] hover:text-[#4F5844] hover:border-[#4F5844] hover:shadow-xs transition-all text-sm sm:text-base font-semibold group"
                      >
                        <span>{page.keyword}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- 미공개 지역 안내문 -->
    <footer class="mt-12 pt-6 border-t border-[#E7D9C1]/60 text-xs text-[#7A7265] leading-relaxed">
      <p>※ 현재 정식 승인 및 검수가 완료된 지역 페이지부터 순차적으로 공개하고 있습니다.</p>
      <p class="mt-1">※ 기재된 자치구 외에도 서울 전역 시공 상담이 가능하며, 현장 사진을 통한 상태 점검을 안내해 드립니다.</p>
    </footer>
  </main>
</BaseLayout>
