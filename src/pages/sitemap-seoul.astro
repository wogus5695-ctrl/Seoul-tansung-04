---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteUrl, getCanonicalUrl, buildWebPageJsonLd, buildBreadcrumbJsonLd } from '../utils/seo.ts';
import { SERVICES } from '../data/services.ts';
import { getPublishedSeoPages, getRegionById } from '../data/pages.ts';

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl('/sitemap-seoul.html', siteUrl);

const pageTitle = '서울 탄성코트 시공지역 안내 | 올케어탄성';
const pageDescription = '올케어탄성의 서울 지역별 탄성코트 및 베란다탄성코트 시공 안내를 확인하세요. 공개된 지역별 상세페이지를 작업 종류에 따라 안내합니다.';

const breadcrumbItems = siteUrl ? [
  { name: '홈', url: `${siteUrl}/` },
  { name: '서울 시공지역 안내', url: canonicalUrl || '' },
] : [];

const jsonLd = siteUrl ? [
  buildWebPageJsonLd(pageTitle, pageDescription, canonicalUrl),
  buildBreadcrumbJsonLd(breadcrumbItems),
] : [];

const publishedPages = getPublishedSeoPages();

// 서비스(작업명)별 자동 그룹화 (신규 지역 승인 시 자동 추가됨)
const serviceGroups = SERVICES.map((service) => {
  const pages = publishedPages.filter((p) => p.serviceId === service.id);
  return {
    service,
    pages,
  };
}).filter((group) => group.pages.length > 0);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/sitemap-seoul.html"
  jsonLd={jsonLd}
>
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- 상단 브레드크럼 및 헤더 -->
    <nav aria-label="브레드크럼" class="flex items-center text-xs text-[#7A7265] mb-4 space-x-2">
      <a href="/" class="hover:text-[#4F5844] transition-colors">홈</a>
      <span class="text-[#E7D9C1]">/</span>
      <span class="text-[#3E443B] font-medium">서울 시공지역 안내</span>
    </nav>

    <header class="border-b border-[#E7D9C1] pb-6 mb-8">
      <span class="inline-block px-3 py-1 bg-[#4F5844]/10 text-[#4F5844] text-xs font-bold rounded-full mb-3 tracking-wide">
        SITE DIRECTORY
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#3E443B] tracking-tight leading-snug">
        서울 탄성코트 시공지역 안내
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#5C5549] leading-relaxed">
        올케어탄성에서 공개한 지역별 탄성코트 및 베란다탄성코트 시공 안내 페이지를 확인할 수 있습니다.
      </p>
    </header>

    <!-- 서비스(작업명)별 그룹 목록 -->
    <div class="space-y-10">
      {serviceGroups.map(({ service, pages }) => (
        <section aria-labelledby={`service-heading-${service.id}`} class="space-y-4">
          <div class="flex items-center gap-2 border-b border-[#E7D9C1]/60 pb-2">
            <h2 id={`service-heading-${service.id}`} class="text-lg sm:text-xl font-bold text-[#3E443B]">
              {service.name}
            </h2>
            <span class="text-xs text-[#5C5549] font-medium">({pages.length}개 지역)</span>
          </div>

          <ul class="divide-y divide-[#E7D9C1]/40 border border-[#E7D9C1] rounded-xl bg-white overflow-hidden shadow-xs">
            {pages.map((page) => {
              const region = getRegionById(page.regionId);
              const linkText = `${region?.name ?? ''} ${service.name}`;
              return (
                <li>
                  <a
                    href={page.urlPath}
                    class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-[#FAF8F5] transition-colors group"
                  >
                    <div class="space-y-0.5">
                      <span class="text-sm sm:text-base font-bold text-[#3E443B] group-hover:text-[#4F5844] transition-colors">
                        {linkText}
                      </span>
                      <span class="block text-xs text-[#7A7265] font-mono">
                        {page.urlPath}
                      </span>
                    </div>
                    <span class="inline-flex items-center text-xs font-semibold text-[#4F5844] shrink-0">
                      상세 안내 보기 &rarr;
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <!-- 미공개 지역 안내 안내문 (단순 텍스트) -->
    <footer class="mt-12 pt-6 border-t border-[#E7D9C1]/60 text-xs text-[#7A7265] leading-relaxed">
      <p>※ 현재 정식 승인 및 검수가 완료된 지역 페이지부터 순차적으로 공개하고 있습니다.</p>
      <p class="mt-1">※ 기재된 자치구 외에도 서울 전역 시공 상담이 가능하며, 현장 사진을 통한 상태 점검을 안내해 드립니다.</p>
    </footer>
  </main>
</BaseLayout>
